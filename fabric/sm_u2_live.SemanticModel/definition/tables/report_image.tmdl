/// Small report photos for HTML Content Secure blocks (presentation asset, not analytic data).
table report_image
	isHidden
	lineageTag: eb511b2c-76b2-40f9-952a-493ec5bb4b93
	sourceLineageTag: [dbo].[report_image]

	/// Photo id used to pick the photo in a visual filter, e.g. photo_zoo_tv_1992_kiel.
	column image_id
		dataType: string
		isHidden
		isKey
		isAvailableInMdx: false
		lineageTag: 13af5b86-98f6-423f-85b7-4d30b3de2ce9
		sourceLineageTag: image_id
		summarizeBy: none
		sourceColumn: image_id

		annotation SummarizationSetBy = Automatic

	/// Source file in docs/design/images/report/.
	column file_name
		dataType: string
		isAvailableInMdx: false
		lineageTag: dd7416de-aaea-4dd5-a270-01aa9bbeead7
		sourceLineageTag: file_name
		summarizeBy: none
		sourceColumn: file_name

		annotation SummarizationSetBy = Automatic

	/// image/jpeg or image/png.
	column mime_type
		dataType: string
		isAvailableInMdx: false
		lineageTag: d3f02231-74e4-4cfe-b7fb-371ed293b536
		sourceLineageTag: mime_type
		summarizeBy: none
		sourceColumn: mime_type

		annotation SummarizationSetBy = Automatic

	/// File size in bytes.
	column bytes
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 52dd37fa-0efb-4839-8a2d-de65033adf75
		sourceLineageTag: bytes
		summarizeBy: none
		sourceColumn: bytes

		annotation SummarizationSetBy = Automatic

	/// Length of the base64 text (sum of chunk lengths).
	column base64_length
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: e1e90aed-a90d-4357-ad94-2c8e5067b891
		sourceLineageTag: base64_length
		summarizeBy: none
		sourceColumn: base64_length

		annotation SummarizationSetBy = Automatic

	/// Number of 8,000-character chunks.
	column chunk_count
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 2f95a792-b930-4dd8-bbd0-7db5c6524349
		sourceLineageTag: chunk_count
		summarizeBy: none
		sourceColumn: chunk_count

