	/// HTML: author line with LinkedIn link.
	measure 'Author p09' = "<div style='font-family:Segoe UI;font-size:16px;color:#ECEDEF'>Built by <b>Vinicius Baccarini</b> · <a href='https://www.linkedin.com/in/vin%C3%ADcius-baccarini/' target='_blank' style='color:#F2A93B;text-decoration:none;font-weight:600'>LinkedIn ↗</a></div>"
		displayFolder: Report\p09 About
		lineageTag: de5a8423-4d34-4303-a353-d88e6fad06e7

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Author p09 · p09_author' = "<div style='height:20px;overflow:hidden'>" & [Author p09] & "</div>"
		displayFolder: Report\p09 About
		lineageTag: ef305a99-c3fd-4dc7-a314-1d66081d11ea

	/// HTML: data limitations with numbers from the model.
	measure 'Limitations p09' = "<div style='font-family:Segoe UI'><div style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#F2A93B'>LIMITATIONS</div><div style='display:flex;gap:30px;margin-top:6px'>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:28px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Shows] - [Shows with Setlist], "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3;margin-top:4px'>shows without a setlist</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:28px;line-height:1;color:#ECEDEF'>" & IF ( [Unmapped Song Share %] < 0.001, "< 0.1%", FORMAT ( [Unmapped Song Share %], "0.0%", "en-US" ) ) & "</div><div style='font-size:12px;color:#A3A9B3;margin-top:4px'>performances not matched to a song</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:28px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Last Refresh Date], "yyyy-mm-dd", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3;margin-top:4px'>last refresh</div></div>" & "</div><div style='font-size:12px;color:#A3A9B3;margin-top:10px'>Early club shows (1976-1980) are often missing. Snippets and tapes are flagged and not counted as performances.</div></div>"
		displayFolder: Report\p09 About
		lineageTag: 7d8f748b-0f1d-46af-8312-98333e31d6b5

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Limitations p09 · p09_limitations' = "<div style='height:192px;overflow:hidden'>" & [Limitations p09] & "</div>"
		displayFolder: Report\p09 About
		lineageTag: 5a2689d2-d7e7-47dc-8022-f0f8ac55aee4

	/// HTML: T-32 spike that tests inline SVG, an SVG data URI, a base64 JPEG and the model photo in HTML Content Secure.
	measure 'Spike HTML' = "<div style='font-family:Segoe UI;color:#ECEDEF;font-size:13px'><p><b>1 · inline SVG:</b> <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Zoo TV: television set'><title>Zoo TV: television set</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='8' y='16' width='32' height='22' rx='3'/><path d='M18 8l6 8 6-8'/><path d='M14 22h14'/></g></svg></p><p><b>2 · SVG data URI in img:</b> <img width='48' src='data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Zoo TV: television set'><title>Zoo TV: television set</title><g fill='none' stroke='%23ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='8' y='16' width='32' height='22' rx='3'/><path d='M18 8l6 8 6-8'/><path d='M14 22h14'/></g></svg>'></p><p><b>3 · base64 JPEG literal in img:</b><br><img width='160' src='data:image/jpeg;base64,'></p><p><b>4 · photo from the model ([Image Data URI]):</b><br>" & IF ( ISBLANK ( [Image Data URI] ), "<i>report_image is empty: load seeds/report_images.csv first</i>", "<img width='240' src='" & [Image Data URI] & "'>" ) & "</p></div>"
		displayFolder: Report\p00 Spike
		lineageTag: 12e45625-15c8-42f8-917a-8a9d45ccd65b

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Spike HTML · p00_html_spike' = "<div style='height:492px;overflow:hidden'>" & [Spike HTML] & "</div>"
		displayFolder: Report\p00 Spike
		lineageTag: e811db33-3cb6-4a8e-8add-5c449f376cac

	/// Title of the album the predicted tour promotes (presentation only).
	measure 'Promoted Album p10' = VAR K = CALCULATE ( SELECTEDVALUE ( dim_tour[album_promoted_key] ), REMOVEFILTERS (), fact_setlist_prediction ) RETURN CALCULATE ( SELECTEDVALUE ( dim_album[album_title] ), REMOVEFILTERS (), dim_album[album_key] = K )
		displayFolder: Report\p10 2027
		lineageTag: 6685f2c1-a02d-4a31-bf9e-4edd0ae85eb8

	/// Display name of the tour the prediction is for (presentation only).
	measure 'Predicted Tour p10' = CALCULATE ( SELECTEDVALUE ( dim_tour[tour_name_display] ), REMOVEFILTERS (), fact_setlist_prediction )
		displayFolder: Report\p10 2027
		lineageTag: eb037af7-63b4-4ab9-b052-71764aa921b0

	/// Predicted setlist slots for songs of the promoted album.
	measure 'New Album Songs Predicted p10' = CALCULATE ( [New Songs Predicted], dim_song[release_role_2027] = "promoted_album" )
		formatString: #,0
		displayFolder: Report\p10 2027
		lineageTag: 663c62e9-e3af-41d9-afe1-ed4407427eb1

	/// Predicted setlist slots for songs of the companion releases (the 2026 EPs).
	measure 'New EP Songs Predicted p10' = CALCULATE ( [New Songs Predicted], dim_song[release_role_2027] = "companion_release" )
		formatString: #,0
		displayFolder: Report\p10 2027
		lineageTag: 3b55fb50-6556-4b88-9ded-3a0515704a9f

	/// Finding-style headline of page 10 (request: promote to the model, data-analyst).
	measure 'Headline p10' = "Our guess for 2027: " & FORMAT ( [Expected Songs per Show], "#,0", "en-US" ) & " songs a night, " & FORMAT ( [New Songs Predicted], "#,0", "en-US" ) & " of them new"
		displayFolder: Report\p10 2027
		lineageTag: 5f394fff-5f3e-488b-833d-33dc19bd2250

	/// Intro paragraph of page 10 with the key numbers in bold (request: promote to the model).
	measure 'First Glimpse p10' = VAR AsOf = [Prediction As-Of Date Key] VAR Obs = [Shows Observed] VAR Opener = MAXX ( FILTER ( SUMMARIZE ( fact_setlist_prediction, dim_song[song_title], fact_setlist_prediction[predicted_position], fact_setlist_prediction[as_of_date_key] ), fact_setlist_prediction[predicted_position] = 1 && fact_setlist_prediction[as_of_date_key] = AsOf ), dim_song[song_title] ) RETURN IF ( Obs = 0, "Before the first show", "After " & FORMAT ( Obs, "#,0", "en-US" ) & " shows" ) & ", our model picks <b>" & FORMAT ( [New Album Songs Predicted p10], "#,0", "en-US" ) & "</b> songs from " & [Promoted Album p10] & ", <b>" & FORMAT ( [New EP Songs Predicted p10], "#,0", "en-US" ) & "</b> from the EPs and <b>" & FORMAT ( [Catalog Songs Predicted], "#,0", "en-US" ) & "</b> older ones" & IF ( NOT ISBLANK ( Opener ), ", opening with <b>" & Opener & "</b>" ) & ". On the album tours since Elevation, <b>" & FORMAT ( [Model Precision at N], "0%", "en-US" ) & "</b> of its picks became core songs, vs <b>" & FORMAT ( [Baseline Precision at N], "0%", "en-US" ) & "</b> for repeating the last album tour."
		displayFolder: Report\p10 2027
		lineageTag: c0d9c868-ac22-47b3-a91a-3f3ae804022a

	/// HTML: page headline and intro paragraph.
	measure 'Header p10' = "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-size:32px;line-height:1.1;color:#ECEDEF;font-weight:600;max-height:72px;overflow:hidden'>" & [Headline p10] & "</div><div style='font-family:Segoe UI;font-size:12.5px;line-height:1.5;color:#A3A9B3;margin-top:8px;max-height:57px;overflow:hidden'>" & [First Glimpse p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 901931bf-3b66-4d14-8387-e3114684c1d0

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Header p10 · p10_headline' = "<div style='height:136px;overflow:hidden'>" & [Header p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: b5a5db78-7dcc-467d-b4bf-bdc5aff031a9

	/// HTML: predicted setlist ticket (tour, numbers, songs in predicted order with chance bars, notes).
	measure 'Ticket p10' = VAR AsOf = [Prediction As-Of Date Key] VAR PickRows = CALCULATETABLE ( SUMMARIZE ( fact_setlist_prediction, dim_song[song_title], dim_song[release_role_2027], fact_setlist_prediction[predicted_position], fact_setlist_prediction[predicted_set], fact_setlist_prediction[model_part], fact_setlist_prediction[probability], fact_setlist_prediction[predicted_in_setlist] ), fact_setlist_prediction[as_of_date_key] = AsOf, fact_setlist_prediction[predicted_in_setlist] = TRUE () ) RETURN IF ( ISEMPTY ( PickRows ), "<div style='font-family:Segoe UI;color:#A3A9B3;font-size:14px'>No prediction in the current selection.</div>", "<div style='background:#20242C;border-radius:10px;overflow:hidden;font-family:Segoe UI;font-size:12px'>" & "<div style='display:flex;gap:16px;align-items:center;padding:12px 16px;background:#262A33;border-bottom:2px dashed #0F1115'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='36' height='36' role='img' aria-label='The Greatest Show on Earth Tour (planned 2027): big top tent'><title>The Greatest Show on Earth Tour (planned 2027): big top tent</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 5v8'/><path d='M24 5l7 2.5-7 2.5'/><path d='M7 27L24 13l17 14'/><path d='M7 27q4.25 4 8.5 0q4.25 4 8.5 0q4.25 4 8.5 0q4.25 4 8.5 0'/><path d='M10 30v10M38 30v10M6 40h36'/><path d='M19 40l5-9 5 9'/></g></svg><div style='flex:1'><div style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#F2A93B'>" & UPPER ( [Predicted Tour p10] ) & "</div><div style='font-size:11px;color:#A3A9B3;margin-top:2px'>Predicted setlist · " & IF ( [Shows Observed] = 0, "before the first show", "after " & FORMAT ( [Shows Observed], "#,0", "en-US" ) & " shows" ) & " · as of " & FORMAT ( [Prediction As-Of Date], "yyyy-mm-dd", "en-US" ) & "</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Expected Songs per Show], "#,0", "en-US" ) & "</div><div style='font-size:11px;color:#A3A9B3;margin-top:2px;white-space:nowrap'>songs a night</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#F2A93B'>" & FORMAT ( [New Songs Predicted], "#,0", "en-US" ) & "</div><div style='font-size:11px;color:#A3A9B3;margin-top:2px;white-space:nowrap'>new: " & FORMAT ( [New Album Songs Predicted p10], "#,0", "en-US" ) & " album · " & FORMAT ( [New EP Songs Predicted p10], "#,0", "en-US" ) & " EP</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Catalog Songs Predicted], "#,0", "en-US" ) & "</div><div style='font-size:11px;color:#A3A9B3;margin-top:2px;white-space:nowrap'>older songs</div></div>" & "</div>" & "<div style='padding:10px 16px 12px'>" & "<div style='display:flex;gap:16px;font-size:10px;color:#A3A9B3;margin:0 0 6px'><span><span style='display:inline-block;width:14px;height:6px;border-radius:3px;background:#F2A93B'></span> new 2026 song (NEW tag)</span><span><span style='display:inline-block;width:14px;height:6px;border-radius:3px;background:#6FA8DC'></span> older song</span><span>bar and % = chance it is a core song (opener: " & FORMAT ( CALCULATE ( [Predicted Probability], fact_setlist_prediction[predicted_position] = 1 ), "0%", "en-US" ) & ")</span></div>" & "<div style='columns:2;column-gap:24px'>" & CONCATENATEX ( PickRows, VAR K = COALESCE ( fact_setlist_prediction[predicted_position], 1000 - fact_setlist_prediction[probability] ) VAR S = fact_setlist_prediction[predicted_set] VAR PrevK = MAXX ( FILTER ( PickRows, COALESCE ( fact_setlist_prediction[predicted_position], 1000 - fact_setlist_prediction[probability] ) < K ), COALESCE ( fact_setlist_prediction[predicted_position], 1000 - fact_setlist_prediction[probability] ) ) VAR PrevS = MAXX ( FILTER ( PickRows, COALESCE ( fact_setlist_prediction[predicted_position], 1000 - fact_setlist_prediction[probability] ) = PrevK ), fact_setlist_prediction[predicted_set] ) RETURN IF ( NOT ISBLANK ( S ) && ( ISBLANK ( PrevK ) || S <> PrevS ), "<div style='color:#F2A93B;font-size:10px;letter-spacing:1.4px;font-weight:700;padding:4px 0 2px'>" & IF ( S = "encore", "ENCORE", "MAIN SET" ) & "</div>" ) & ( VAR Pos = fact_setlist_prediction[predicted_position] VAR Pr = fact_setlist_prediction[probability] VAR IsNew = fact_setlist_prediction[model_part] = "new" VAR Bar = IF ( IsNew, "#F2A93B", "#6FA8DC" ) RETURN "<div style='display:flex;align-items:center;gap:6px;min-height:21px;break-inside:avoid'><div style='width:16px;text-align:right;color:#A3A9B3;flex:none'>" & COALESCE ( Pos, "·" ) & "</div><div style='flex:1;color:#ECEDEF;line-height:1.2'>" & dim_song[song_title] & "</div>" & IF ( IsNew, "<div style='font-size:9px;font-weight:700;letter-spacing:.5px;border-radius:7px;padding:0 4px;flex:none;color:#F2A93B;border:1px solid #F2A93B'>NEW · " & IF ( dim_song[release_role_2027] = "companion_release", "EP", "ALBUM" ) & "</div>" ) & "<div style='width:34px;height:6px;background:#2A2F38;border-radius:3px;flex:none'><div style='height:6px;border-radius:3px;background:" & Bar & ";width:" & MAX ( 1, INT ( 34 * Pr ) ) & "px'></div></div><div style='width:28px;text-align:right;color:#ECEDEF;flex:none'>" & FORMAT ( Pr, "0%", "en-US" ) & "</div></div>" ), "", COALESCE ( fact_setlist_prediction[predicted_position], 1000 - fact_setlist_prediction[probability] ), ASC ) & "</div>" & "<div style='font-size:10.5px;line-height:1.4;color:#A3A9B3;margin-top:8px;border-top:1px solid #2A2F38;padding-top:6px'>Order is approximate: each older song sits where it played on the previous album tour, new songs where that tour placed its new songs. The % is the chance of being a core song (played at half the shows or more); older songs' chances are not rescaled, so they do not add up to " & FORMAT ( [Expected Songs per Show], "#,0", "en-US" ) & ". The list is the top " & FORMAT ( [Expected Songs per Show], "#,0", "en-US" ) & ", with new and older slots filled separately.</div>" & "</div></div>" )
		displayFolder: Report\p10 2027
		lineageTag: 91a4b699-78e8-48c3-aa6b-0120a7e35bba

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Ticket p10 · p10_setlist_ticket' = "<div style='height:472px;overflow:hidden'>" & [Ticket p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 608287cd-2b75-44de-badb-68b760b318b1

	/// Release of a 2026 song: its album, or the promoted album for its bonus track (presentation only).
	measure 'Release p10' = VAR K = SELECTEDVALUE ( dim_song[album_key] ) VAR A = CALCULATE ( SELECTEDVALUE ( dim_album[album_title] ), REMOVEFILTERS (), dim_album[album_key] = K ) RETURN IF ( HASONEVALUE ( dim_song[song_title] ), IF ( ISBLANK ( A ) || K = -1, [Promoted Album p10] & " (bonus)", A ) )
		displayFolder: Report\p10 2027
		lineageTag: cfab81fa-2d42-406f-846a-143702af29e7

	/// Text marker for songs in the predicted setlist (second cue next to the colour).
	measure 'In Setlist p10' = IF ( HASONEVALUE ( dim_song[song_title] ), IF ( [Predicted Songs] > 0, "✓ picked", "" ) )
		displayFolder: Report\p10 2027
		lineageTag: a33ef29e-3cdf-416a-832f-36184814dcf0

	/// Accent for picked songs (presentation only).
	measure 'Song Colour p10' = IF ( [Predicted Songs] > 0, "#F2A93B", "#ECEDEF" )
		displayFolder: Report\p10 2027
		lineageTag: 4343dbd0-81f5-45f1-9472-f1111b13b599

	/// Visual title with the total (presentation only).
	measure 'Title p10 new songs' = "All " & FORMAT ( CALCULATE ( [Candidate Songs], NOT ISBLANK ( dim_song[release_role_2027] ) ), "#,0", "en-US" ) & " new songs, by release: " & FORMAT ( [New Songs Predicted], "#,0", "en-US" ) & " make the setlist"
		displayFolder: Report\p10 2027
		lineageTag: 3db5c3be-ad75-49c8-8948-71398f4a8955

	/// Annotation: new songs whose slot is decided by a tie in the model's score (SPEC-09 honesty note).
	measure 'Ties Note p10' = VAR AsOf = [Prediction As-Of Date Key] VAR R = CALCULATETABLE ( SUMMARIZE ( fact_setlist_prediction, dim_song[song_title], dim_song[release_role_2027], fact_setlist_prediction[predicted_position], fact_setlist_prediction[predicted_set], fact_setlist_prediction[model_part], fact_setlist_prediction[probability], fact_setlist_prediction[predicted_in_setlist] ), fact_setlist_prediction[as_of_date_key] = AsOf, REMOVEFILTERS ( dim_song ), NOT ISBLANK ( dim_song[release_role_2027] ) ) VAR PA = MINX ( FILTER ( R, dim_song[release_role_2027] = "promoted_album" && fact_setlist_prediction[predicted_in_setlist] ), fact_setlist_prediction[probability] ) VAR PE = MINX ( FILTER ( R, dim_song[release_role_2027] = "companion_release" && fact_setlist_prediction[predicted_in_setlist] ), fact_setlist_prediction[probability] ) VAR TA = COUNTROWS ( FILTER ( R, dim_song[release_role_2027] = "promoted_album" && ROUND ( fact_setlist_prediction[probability], 6 ) = ROUND ( PA, 6 ) ) ) VAR KA = COUNTROWS ( FILTER ( R, dim_song[release_role_2027] = "promoted_album" && fact_setlist_prediction[predicted_in_setlist] && ROUND ( fact_setlist_prediction[probability], 6 ) = ROUND ( PA, 6 ) ) ) VAR TE = COUNTROWS ( FILTER ( R, dim_song[release_role_2027] = "companion_release" && ROUND ( fact_setlist_prediction[probability], 6 ) = ROUND ( PE, 6 ) ) ) VAR KE = COUNTROWS ( FILTER ( R, dim_song[release_role_2027] = "companion_release" && fact_setlist_prediction[predicted_in_setlist] && ROUND ( fact_setlist_prediction[probability], 6 ) = ROUND ( PE, 6 ) ) ) VAR TieA = TA > KA VAR TieE = TE > KE RETURN IF ( TieA || TieE, "Toss-ups the model cannot settle: " & IF ( TieA, KA & " of the " & TA & " album songs tied at " & FORMAT ( PA, "0%", "en-US" ) & " got a slot" ) & IF ( TieA && TieE, ", and " ) & IF ( TieE, KE & " of the " & TE & " EP songs tied at " & FORMAT ( PE, "0%", "en-US" ) & IF ( TieA, "", " got a slot" ) ) & ". Which ones is arbitrary.", "No ties among the new-song picks." )
		displayFolder: Report\p10 2027
		lineageTag: 83c97f6c-f5fc-47fd-84fd-1f96793cd79a

	/// Typography wrapper (presentation only).
	measure 'Ties Note p10 · p10_ties_note' = "<div style='font-family:Segoe UI;font-size:12.5px;line-height:1.1;color:#F2A93B;font-weight:600;font-style:italic;max-height:28px;overflow:hidden'>" & [Ties Note p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 4bf2bc67-b27d-419c-b07b-91a7a6e1dcb1

	/// HTML: backtest section intro with the model's lead over the baseline as a big number.
	measure 'Backtest Intro p10' = "<div style='display:flex;gap:14px;align-items:flex-start;font-family:Segoe UI'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:30px;line-height:1;color:#F2A93B;flex:none'>" & FORMAT ( [Model vs. Baseline] * 100, "+0.0;-0.0;0.0", "en-US" ) & " pp" & "</div><div style='font-size:12px;line-height:1.4;color:#A3A9B3'><span style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#F2A93B'>HOW GOOD IS THIS?</span> Replayed on every album tour since Zoo TV, knowing only what came before its first show: more of its picks became core songs (played at half the shows or more) than with " & [Selected Baseline] & ", the best simple rule.</div></div>"
		displayFolder: Report\p10 2027
		lineageTag: ea0bd9f7-4d52-4195-b86d-ad731570485e

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Backtest Intro p10 · p10_backtest_intro' = "<div style='height:48px;overflow:hidden'>" & [Backtest Intro p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 46c35be2-5d8d-4518-9a3b-f1e73d445c5d

	/// HTML: backtest precision of the model and the three baselines as labelled bars.
	measure 'Backtest Bars p10' = VAR P_model = CALCULATE ( [Mean Precision at N], fact_setlist_backtest[method] = "model" ) VAR P_B1 = CALCULATE ( [Mean Precision at N], fact_setlist_backtest[method] = "B1" ) VAR P_B2 = CALCULATE ( [Mean Precision at N], fact_setlist_backtest[method] = "B2" ) VAR P_B3 = CALCULATE ( [Mean Precision at N], fact_setlist_backtest[method] = "B3" ) RETURN "<div style='font-family:Segoe UI;font-size:12px'><div style='font-size:11px;color:#A3A9B3;margin-bottom:4px'>Share of the picks that became core songs, album tours since Elevation</div>" & "<div style='display:flex;align-items:center;gap:10px;height:22px'><div style='width:216px;flex:none;white-space:nowrap;color:#F2A93B;font-weight:700;'>Model</div><div style='flex:1;height:10px'><div style='height:10px;border-radius:2px;background:#F2A93B;width:" & FORMAT ( 100 * COALESCE ( P_model, 0 ), "0", "en-US" ) & "%'></div></div><div style='width:40px;flex:none;text-align:right;font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:15px;color:#F2A93B'>" & FORMAT ( P_model, "0%", "en-US" ) & "</div></div>" & "<div style='display:flex;align-items:center;gap:10px;height:22px'><div style='width:216px;flex:none;white-space:nowrap;color:#ECEDEF;'>B1 · repeat the last album tour</div><div style='flex:1;height:10px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & FORMAT ( 100 * COALESCE ( P_B1, 0 ), "0", "en-US" ) & "%'></div></div><div style='width:40px;flex:none;text-align:right;font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:15px;color:#ECEDEF'>" & FORMAT ( P_B1, "0%", "en-US" ) & "</div></div>" & "<div style='display:flex;align-items:center;gap:10px;height:22px'><div style='width:216px;flex:none;white-space:nowrap;color:#ECEDEF;'>B2 · career's most played songs</div><div style='flex:1;height:10px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & FORMAT ( 100 * COALESCE ( P_B2, 0 ), "0", "en-US" ) & "%'></div></div><div style='width:40px;flex:none;text-align:right;font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:15px;color:#ECEDEF'>" & FORMAT ( P_B2, "0%", "en-US" ) & "</div></div>" & "<div style='display:flex;align-items:center;gap:10px;height:22px'><div style='width:216px;flex:none;white-space:nowrap;color:#ECEDEF;'>B3 · latest tour (Sphere for 2027)</div><div style='flex:1;height:10px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & FORMAT ( 100 * COALESCE ( P_B3, 0 ), "0", "en-US" ) & "%'></div></div><div style='width:40px;flex:none;text-align:right;font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:15px;color:#ECEDEF'>" & FORMAT ( P_B3, "0%", "en-US" ) & "</div></div>" & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: c874799b-c2ae-4a8f-86a1-3328755e8722

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Backtest Bars p10 · p10_backtest_bars' = "<div style='height:104px;overflow:hidden'>" & [Backtest Bars p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 6fe27a76-f690-4991-b833-ce86fa2ff5e9

	/// Annotation: the model against the baseline on the closest analog tour (SPEC-09 honesty note).
	measure 'Closest Analog Note p10' = VAR EI = "eXPERIENCE + iNNOCENCE Tour" VAR M = CALCULATE ( [Model Precision at N], dim_tour[tour_name_display] = EI ) VAR B = CALCULATE ( [Baseline Precision at N], dim_tour[tour_name_display] = EI ) RETURN IF ( NOT ISBLANK ( M ), "On the e+i tour (2018), the closest match to 2027 with a new album next to a companion record, the model " & IF ( ABS ( M - B ) < 0.005, "only tied", IF ( M > B, "beat", "lost to" ) ) & " " & [Selected Baseline] & ": " & FORMAT ( M, "0%", "en-US" ) & " vs " & FORMAT ( B, "0%", "en-US" ) & "." )
		displayFolder: Report\p10 2027
		lineageTag: a9b9868e-819a-4a42-90e9-aac4f276e0ae

	/// Typography wrapper (presentation only).
	measure 'Closest Analog Note p10 · p10_analog_note' = "<div style='font-family:Segoe UI;font-size:12.5px;line-height:1.1;color:#F2A93B;font-weight:600;font-style:italic;max-height:28px;overflow:hidden'>" & [Closest Analog Note p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: 13a57e96-7e86-4044-8a30-2a0161ad52f7

	/// Shows of the predicted tour played at the latest prediction (0 before the first show).
	measure 'Tour Started p10' = CALCULATE ( [Shows Observed], REMOVEFILTERS ( dim_date ) )
		formatString: #,0
		displayFolder: Report\p10 2027
		lineageTag: 93b2777b-03fe-4f7e-a4ca-a83e74e21236

	/// HTML: in-tour section intro, an empty-state message before the first show.
	measure 'Tracker Intro p10' = VAR Obs = [Tour Started p10] VAR H = CALCULATE ( [Hit Rate], REMOVEFILTERS ( dim_date ) ) RETURN "<div style='font-family:Segoe UI;font-size:12px;line-height:1.4;color:#A3A9B3'><span style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#F2A93B'>ONCE THE TOUR STARTS</span> " & IF ( Obs = 0 || ISBLANK ( H ), "No show of the tour yet, so these charts are empty. After each show they compare the predicted setlist with what was played and follow how the chances move.", "After <b style='color:#ECEDEF'>" & FORMAT ( Obs, "#,0", "en-US" ) & "</b> shows, <b style='color:#ECEDEF'>" & FORMAT ( H, "0%", "en-US" ) & "</b> of the predicted songs were played per show, on average." ) & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: eff06323-a0af-400e-b4c1-d2b052807dc3

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Tracker Intro p10 · p10_tracker_intro' = "<div style='height:36px;overflow:hidden'>" & [Tracker Intro p10] & "</div>"
		displayFolder: Report\p10 2027
		lineageTag: d8123489-0e1c-4642-b5b8-66e059ec90a7

