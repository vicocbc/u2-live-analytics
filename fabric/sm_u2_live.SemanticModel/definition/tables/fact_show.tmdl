	/// HTML: residency vs touring head-to-head with bars and differences.
	measure 'Head to Head p06' = "<div style='display:grid;grid-template-columns:140px 1fr 1fr 110px;row-gap:12px;align-items:center;font-family:Segoe UI'><div></div><div style='font-size:11px;font-weight:700;letter-spacing:1.5px;color:#F2A93B'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='14' height='14' role='img' aria-label='Sphere residency: globe'><title>Sphere residency: globe</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='17'/><path d='M8 19h32M8 29h32'/><ellipse cx='24' cy='24' rx='7' ry='17'/></g></svg> RESIDENCY</div><div style='font-size:11px;font-weight:700;letter-spacing:1.5px;color:#A3A9B3'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='14' height='14' role='img' aria-label='Innocence + Experience: light bulb'><title>Innocence + Experience: light bulb</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M18 30c-4-3-6-7-6-11a12 12 0 0124 0c0 4-2 8-6 11v4H18z'/><path d='M19 39h10'/></g></svg> TOURING</div><div style='font-size:11px;font-weight:700;letter-spacing:1.5px;color:#A3A9B3'>DIFFERENCE</div>" & "<div style='color:#ECEDEF;font-size:13px'>Songs a night</div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#F2A93B;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Residency Songs per Show], 0 ), 30 ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#F2A93B'>" & FORMAT ( COALESCE ( [Residency Songs per Show], 0 ), "0.0", "en-US" ) & "</span></div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Touring Songs per Show], 0 ), 30 ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#ECEDEF'>" & FORMAT ( COALESCE ( [Touring Songs per Show], 0 ), "0.0", "en-US" ) & "</span></div>" & "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;color:" & IF ( COALESCE ( [Difference Songs per Show], 0 ) >= 0, "#F2A93B", "#E06666" ) & "'>" & IF ( COALESCE ( [Difference Songs per Show], 0 ) > 0, "+", "" ) & FORMAT ( COALESCE ( [Difference Songs per Show], 0 ), "0.0", "en-US" ) & "</div>" & "<div style='color:#ECEDEF;font-size:13px'>Different songs</div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#F2A93B;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Residency Distinct Songs], 0 ), MAX ( [Residency Distinct Songs], [Touring Distinct Songs] ) ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#F2A93B'>" & FORMAT ( COALESCE ( [Residency Distinct Songs], 0 ), "#,0", "en-US" ) & "</span></div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Touring Distinct Songs], 0 ), MAX ( [Residency Distinct Songs], [Touring Distinct Songs] ) ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#ECEDEF'>" & FORMAT ( COALESCE ( [Touring Distinct Songs], 0 ), "#,0", "en-US" ) & "</span></div>" & "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;color:" & IF ( COALESCE ( [Difference Distinct Songs], 0 ) >= 0, "#F2A93B", "#E06666" ) & "'>" & IF ( COALESCE ( [Difference Distinct Songs], 0 ) > 0, "+", "" ) & FORMAT ( COALESCE ( [Difference Distinct Songs], 0 ), "#,0", "en-US" ) & "</div>" & "<div style='color:#ECEDEF;font-size:13px'>Achtung Baby share</div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#F2A93B;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Residency Achtung Baby Share %], 0 ), 1 ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#F2A93B'>" & FORMAT ( COALESCE ( [Residency Achtung Baby Share %], 0 ), "0%", "en-US" ) & "</span></div>" & "<div style='display:flex;align-items:center;gap:8px'><div style='height:10px;border-radius:2px;background:#6E7581;width:" & INT ( 140 * DIVIDE ( COALESCE ( [Touring Achtung Baby Share %], 0 ), 1 ) ) & "px'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:22px;color:#ECEDEF'>" & FORMAT ( COALESCE ( [Touring Achtung Baby Share %], 0 ), "0%", "en-US" ) & "</span></div>" & "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;color:" & IF ( COALESCE ( [Difference Achtung Baby Share (pp)], 0 ) >= 0, "#F2A93B", "#E06666" ) & "'>" & IF ( COALESCE ( [Difference Achtung Baby Share (pp)], 0 ) > 0, "+", "" ) & FORMAT ( COALESCE ( [Difference Achtung Baby Share (pp)], 0 ), "0", "en-US" ) & " pp</div>" & "</div>"
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: a1039495-c679-40d3-a029-8b57342e6072

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Head to Head p06 · p06_head_to_head' = "<div style='height:180px;overflow:hidden'>" & [Head to Head p06] & "</div>"
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: 47fa8f00-f42d-4ae9-82bf-516bd22cfd00

	/// Bound to model measure [Annotation p06] (T-35); kept so the text cards keep their binding.
	measure 'ph Annotation p06' = [Annotation p06]
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: 606d00d6-07db-4d3e-b4a0-9c4040bb9957

	/// Typography wrapper (presentation only).
	measure 'ph Annotation p06 · p06_note' = "<div style='font-family:Segoe UI;font-size:13px;line-height:1.1;color:#F2A93B;font-weight:600;font-style:italic;max-height:20px;overflow:hidden'>" & [ph Annotation p06] & "</div>"
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: 2d06f56a-2cfa-4828-a302-d0c3a6259360

	/// Show date as a decimal year: residency shows always, other shows of the compared tours.
	measure 'Show Year Decimal' = IF ( CALCULATE ( COUNTROWS ( fact_show ), REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () ) > 0, CALCULATE ( VAR D = CALCULATE ( MIN ( dim_date[date] ), fact_show ) RETURN YEAR ( D ) + DIVIDE ( INT ( D - DATE ( YEAR ( D ), 1, 1 ) ), 366 ), REMOVEFILTERS ( dim_tour ) ), IF ( ISFILTERED ( dim_tour[tour_name_display] ), VAR D = CALCULATE ( MIN ( dim_date[date] ), fact_show ) RETURN YEAR ( D ) + DIVIDE ( INT ( D - DATE ( YEAR ( D ), 1, 1 ) ), 366 ), CALCULATE ( VAR D = CALCULATE ( MIN ( dim_date[date] ), fact_show ) RETURN YEAR ( D ) + DIVIDE ( INT ( D - DATE ( YEAR ( D ), 1, 1 ) ), 366 ), KEEPFILTERS ( dim_tour[era] = "2015-2019 Innocence and Experience" ) ) ) )
		formatString: 0
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: 3b8ea0ba-b3a6-425c-82f9-29b6c5d78592

	/// Songs in the show: residency shows always, other shows of the compared tours (default 2015-2019).
	measure 'Songs in Show p06' = IF ( CALCULATE ( COUNTROWS ( fact_show ), REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () ) > 0, CALCULATE ( [Performances], REMOVEFILTERS ( dim_tour ) ), IF ( ISFILTERED ( dim_tour[tour_name_display] ), [Performances], CALCULATE ( [Performances], KEEPFILTERS ( dim_tour[era] = "2015-2019 Innocence and Experience" ) ) ) )
		formatString: #,0
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: d3de2781-03c2-4c5e-b0d1-3c9d1c2b50b9

	/// Accent for residency shows, grey for touring shows (presentation only).
	measure 'Show Dot Colour p06' = IF ( CALCULATE ( COUNTROWS ( fact_show ), REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () ) > 0, "#F2A93B", "#6E7581" )
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: 95ebd5f8-f617-4d90-9d71-3f7039916e4d

	/// Dynamic title of the p06 every-show chart.
	measure 'Title p06 every show' = "Every show, one dot: Sphere (amber) vs " & IF ( ISFILTERED ( dim_tour[tour_name_display] ), IF ( COUNTROWS ( VALUES ( dim_tour[tour_name_display] ) ) <= 2, CONCATENATEX ( VALUES ( dim_tour[tour_name_display] ), dim_tour[tour_name_display], " and " ), COUNTROWS ( VALUES ( dim_tour[tour_name_display] ) ) & " tours" ), "the 2015-2019 tours" ) & " (grey) · right-click a dot for its setlist"
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: c4e0014e-abc4-4829-9bb8-609d7f32a9ca

	/// HTML: song drill-through card, or a prompt when no single song is in context.
	measure 'Song Card p07' = IF ( HASONEVALUE ( dim_song[song_title] ), "<div style='font-family:Segoe UI'><div style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#F2A93B'>SONG · " & UPPER ( COALESCE ( CALCULATE ( SELECTEDVALUE ( dim_album[album_label] ), dim_song ), "not on a studio album" ) ) & IF ( NOT ISBLANK ( SELECTEDVALUE ( dim_song[first_release_year] ) ), " (" & SELECTEDVALUE ( dim_song[first_release_year] ) & ")" ) & "</div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:36px;line-height:1.05;color:#ECEDEF;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & [Selected Song] & "</div><div style='display:flex;gap:30px;margin-top:12px'>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:30px;line-height:1;color:#F2A93B'>" & FORMAT ( [Performances], "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>performances</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:30px;line-height:1;color:#ECEDEF'>" & FORMAT ( [First Played Date], "yyyy-mm-dd", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>live debut</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:30px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Last Played Date], "yyyy-mm-dd", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>last played</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:30px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Years Since Last Played], "0", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>years since</div></div>" & "</div></div>", "<div style='font-family:Segoe UI;color:#A3A9B3;font-size:14px;padding-top:8px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:28px;color:#ECEDEF'>Nothing selected yet</div>Right-click a song on the Songs page and choose Drill through → Song to see its story.</div>" )
		displayFolder: Report\p07 Song Detail
		lineageTag: 36221282-9258-4d91-a1cd-fba9bbe09cb7

	/// 1 when exactly one song is in context (drill-through page filter).
	measure 'Is One Song' = IF ( HASONEVALUE ( dim_song[song_title] ), 1, 0 )
		formatString: #,0
		displayFolder: Report\p07 Song Detail
		lineageTag: 4d295fd7-30b6-474a-b52d-c6752be65f95

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Song Card p07 · p07_song_card' = "<div style='height:136px;overflow:hidden'>" & [Song Card p07] & "</div>"
		displayFolder: Report\p07 Song Detail
		lineageTag: c338816b-678c-44e6-8456-fe5c2f16050a

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p07 shows' = "Every time it was played: " & FORMAT ( CALCULATE ( [Shows Played], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " shows · right-click one for its setlist"
		displayFolder: Report\p07 Song Detail
		lineageTag: 9e2d5951-c9a9-4d35-8b34-f6a01feece2f

	/// HTML: where in the night the song is played (opener, encore, closer shares).
	measure 'Position p07' = IF ( HASONEVALUE ( dim_song[song_title] ), "<div style='font-family:Segoe UI'>" & "<div style='display:grid;grid-template-columns:90px 1fr 56px;align-items:center;gap:8px;margin:6px 0'><span style='color:#ECEDEF;font-size:13px'>Opener</span><div style='height:12px;border-radius:2px;background:#93C47D;width:" & FORMAT ( MAX ( 100 * COALESCE ( DIVIDE ( [Opener Count], [Performances] ), 0 ), IF ( [Opener Count] > 0, 1, 0 ) ), "0.0", "en-US" ) & "%'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:18px;color:#ECEDEF'>" & FORMAT ( COALESCE ( DIVIDE ( [Opener Count], [Performances] ), 0 ), "0%", "en-US" ) & "</span></div>" & "<div style='display:grid;grid-template-columns:90px 1fr 56px;align-items:center;gap:8px;margin:6px 0'><span style='color:#ECEDEF;font-size:13px'>Encore</span><div style='height:12px;border-radius:2px;background:#B4A7D6;width:" & FORMAT ( MAX ( 100 * COALESCE ( DIVIDE ( [Encore Count], [Performances] ), 0 ), IF ( [Encore Count] > 0, 1, 0 ) ), "0.0", "en-US" ) & "%'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:18px;color:#ECEDEF'>" & FORMAT ( COALESCE ( DIVIDE ( [Encore Count], [Performances] ), 0 ), "0%", "en-US" ) & "</span></div>" & "<div style='display:grid;grid-template-columns:90px 1fr 56px;align-items:center;gap:8px;margin:6px 0'><span style='color:#ECEDEF;font-size:13px'>Closer</span><div style='height:12px;border-radius:2px;background:#F6B26B;width:" & FORMAT ( MAX ( 100 * COALESCE ( DIVIDE ( [Closer Count], [Performances] ), 0 ), IF ( [Closer Count] > 0, 1, 0 ) ), "0.0", "en-US" ) & "%'></div><span style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:18px;color:#ECEDEF'>" & FORMAT ( COALESCE ( DIVIDE ( [Closer Count], [Performances] ), 0 ), "0%", "en-US" ) & "</span></div>" & "<div style='color:#A3A9B3;font-size:11px;margin-top:6px'>Share of the song's performances; the rest were in the main set.</div></div>", "" )
		displayFolder: Report\p07 Song Detail
		lineageTag: d4e1752f-99fc-4b0d-91bd-2832bf1ab90c

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Position p07 · p07_position' = "<div style='height:180px;overflow:hidden'>" & [Position p07] & "</div>"
		displayFolder: Report\p07 Song Detail
		lineageTag: bc167afb-c2ed-4baa-820c-8b5bee937ccc

	/// HTML: show ticket stub with the setlist in position order, or a prompt when no show is selected.
	measure 'Ticket p08' = VAR D = CALCULATE ( MIN ( dim_date[date] ), fact_show ) VAR SetRows = CALCULATETABLE ( SUMMARIZE ( fact_performance, fact_performance[setlist_position], fact_performance[set_name], dim_song[song_title], fact_performance[is_live_debut], fact_performance[is_cover], fact_performance[guest_artist], fact_performance[is_snippet], fact_performance[is_tape] ) ) VAR Tapes = COUNTROWS ( FILTER ( SetRows, fact_performance[is_tape] ) ) VAR Snips = COUNTROWS ( FILTER ( SetRows, fact_performance[is_snippet] && NOT fact_performance[is_tape] ) ) VAR Extras = Tapes + Snips VAR NoTour = CALCULATE ( SELECTEDVALUE ( dim_tour[tour_name] ), fact_show ) = "(No tour)" RETURN IF ( HASONEVALUE ( dim_show[show_label] ), "<div style='display:flex;background:#20242C;border-radius:10px;overflow:hidden;height:600px;font-family:Segoe UI'><div style='width:230px;padding:18px;border-right:2px dashed #0F1115;background:#262A33'>" & SUBSTITUTE ( SUBSTITUTE ( CALCULATE ( [Tour Icon SVG], fact_show ), "width='48'", "width='40'" ), "height='48'", "height='40'" ) & "<div style='color:#F2A93B;font-size:11px;letter-spacing:1.5px;font-weight:700;margin-top:10px'>" & UPPER ( CALCULATE ( SELECTEDVALUE ( dim_tour[tour_name_display] ), fact_show ) ) & "</div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:36px;line-height:1.05;color:#ECEDEF'>" & UPPER ( FORMAT ( D, "d mmm", "en-US" ) ) & "<br>" & YEAR ( D ) & "</div><div style='margin-top:10px;font-size:12.5px;color:#A3A9B3'><b style='color:#ECEDEF'>" & CALCULATE ( SELECTEDVALUE ( dim_venue[venue_name] ), fact_show ) & "</b><br>" & CALCULATE ( SELECTEDVALUE ( dim_venue[city_name] ), fact_show ) & ", " & CALCULATE ( SELECTEDVALUE ( dim_venue[country_name] ), fact_show ) & "</div>" & "<div style='margin-top:14px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Performances], "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3'>songs" & IF ( Extras > 0, " + " & Extras & IF ( Tapes > 0 && Snips = 0, IF ( Tapes = 1, " tape", " tapes" ), IF ( Snips > 0 && Tapes = 0, IF ( Snips = 1, " snippet", " snippets" ), " tapes/snippets" ) ) ) & "</div></div>" & IF ( NoTour, "<div style='margin-top:14px;font-size:12px;color:#A3A9B3'>One-off show, outside a tour</div>", "<div style='margin-top:14px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Tour Avg Songs per Show], "0.0", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3'>songs a night on this tour</div></div>" ) & "<div style='margin-top:14px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#F2A93B'>" & FORMAT ( COALESCE ( [Live Debuts], 0 ), "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3'>live debuts ★</div></div>" & "<div style='margin-top:14px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:26px;line-height:1;color:#ECEDEF'>" & FORMAT ( COALESCE ( [Covers Played], 0 ), "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#A3A9B3'>covers</div></div>" & "</div><div style='flex:1;padding:16px 20px;columns:2;column-gap:28px;font-size:12px'>" & CONCATENATEX ( SetRows, VAR P = fact_performance[setlist_position] VAR S = fact_performance[set_name] VAR PrevP = MAXX ( FILTER ( SetRows, fact_performance[setlist_position] < P ), fact_performance[setlist_position] ) VAR PrevS = MAXX ( FILTER ( SetRows, fact_performance[setlist_position] = PrevP ), fact_performance[set_name] ) RETURN IF ( ISBLANK ( PrevP ) || S <> PrevS, "<div style='color:#F2A93B;font-size:10px;letter-spacing:1.4px;font-weight:700;padding-top:8px'>" & UPPER ( S ) & "</div>" ) & ( VAR Dim = fact_performance[is_snippet] || fact_performance[is_tape] RETURN "<div style='display:flex;align-items:center;gap:8px;padding:2px 0;opacity:" & IF ( Dim, "0.55", "1" ) & "'><span style='color:#A3A9B3;width:20px;text-align:right;flex:none'>" & P & "</span><span style='color:#ECEDEF;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>" & dim_song[song_title] & "</span><span style='margin-left:auto;display:flex;gap:4px;flex:none'>" & IF ( fact_performance[is_live_debut], "<span style='font-size:10px;border-radius:8px;padding:0 5px;white-space:nowrap;color:#F2A93B;border:1px solid #F2A93B'>★ debut</span>" ) & IF ( fact_performance[is_cover], "<span style='font-size:10px;border-radius:8px;padding:0 5px;white-space:nowrap;color:#A3A9B3;border:1px solid #2A2F38'>cover</span>" ) & IF ( NOT ISBLANK ( fact_performance[guest_artist] ), "<span style='font-size:10px;border-radius:8px;padding:0 5px;white-space:nowrap;color:#A3A9B3;border:1px solid #2A2F38'>with " & fact_performance[guest_artist] & "</span>" ) & IF ( fact_performance[is_tape], "<span style='font-size:10px;border-radius:8px;padding:0 5px;white-space:nowrap;color:#A3A9B3;border:1px dashed #6E7581'>tape</span>" ) & IF ( fact_performance[is_snippet], "<span style='font-size:10px;border-radius:8px;padding:0 5px;white-space:nowrap;color:#A3A9B3;border:1px dashed #6E7581'>snippet</span>" ) & "</span></div>" ), "", fact_performance[setlist_position], ASC ) & "</div></div>", "<div style='font-family:Segoe UI;color:#A3A9B3;font-size:14px;padding-top:8px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:28px;color:#ECEDEF'>Nothing selected yet</div>Right-click a show in a shows list (Road page, Sphere dots, or a song's list) and choose Drill through → Show.</div>" )
		displayFolder: Report\p08 Show Detail
		lineageTag: c8126234-4567-44a1-a1f9-88608583637e

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Ticket p08 · p08_ticket' = "<div style='height:608px;overflow:hidden'>" & [Ticket p08] & "</div>"
		displayFolder: Report\p08 Show Detail
		lineageTag: 22fe06c7-0822-4720-9a59-b8171e851e33

	/// Web link of the selected show on setlist.fm.
	measure 'Setlist URL p08' = IF ( HASONEVALUE ( dim_show[show_label] ), SELECTEDVALUE ( dim_show[setlist_url] ) )
		displayFolder: Report\p08 Show Detail
		lineageTag: 706b0fdc-ef66-4e84-bd6b-cb7ba5ad31bb

	/// HTML: link to the selected show on setlist.fm.
	measure 'Setlist Link p08' = IF ( NOT ISBLANK ( [Setlist URL p08] ), "<a href='" & [Setlist URL p08] & "' target='_blank' style='font-family:Segoe UI;font-size:15px;color:#F2A93B;text-decoration:none;font-weight:600'>Open this show on setlist.fm ↗</a>" )
		displayFolder: Report\p08 Show Detail
		lineageTag: af079787-dc0c-45c1-acf5-d5690f329d8b

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Setlist Link p08 · p08_setlist_link' = "<div style='height:20px;overflow:hidden'>" & [Setlist Link p08] & "</div>"
		displayFolder: Report\p08 Show Detail
