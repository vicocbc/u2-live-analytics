		lineageTag: 799b76c7-82e0-4358-bbf4-80758b162862

	/// HTML: page headline and intro paragraph from the model text measures (T-35).
	measure 'Header p06' = "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-size:32px;line-height:1.1;color:#ECEDEF;font-weight:600;max-height:72px;overflow:hidden'>" & [Headline p06] & "</div><div style='font-family:Segoe UI;font-size:12.5px;line-height:1.5;color:#A3A9B3;margin-top:8px;max-height:57px;overflow:hidden'>" & [First Glimpse p06] & "</div>"
