		displayFolder: Report\p04 Albums on Stage
		lineageTag: 1714fd6d-ff63-4c66-a61f-b6fd1624537f

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Header p04 · p04_headline' = "<div style='height:144px;overflow:hidden'>" & [Header p04] & "</div>"
		displayFolder: Report\p04 Albums on Stage
		lineageTag: 7b545103-fb8e-4eae-b42c-9f8647be2e8c

	/// Bound to model measure [Annotation p04] (T-35); kept so the text cards keep their binding.
	measure 'ph Annotation p04' = [Annotation p04]
		displayFolder: Report\p04 Albums on Stage
		lineageTag: ca9346d6-f4e2-47b4-8e96-aaa598ba26e2

	/// Typography wrapper (presentation only).
	measure 'ph Annotation p04 · p04_area_note' = "<div style='font-family:Segoe UI;font-size:13px;line-height:1.1;color:#F2A93B;font-weight:600;font-style:italic;max-height:16px;overflow:hidden'>" & [ph Annotation p04] & "</div>"
		displayFolder: Report\p04 Albums on Stage
		lineageTag: 72b67c28-4ab5-4bc8-92a3-0bf03e1e5109

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p04 albums' = "Which albums stay: all " & FORMAT ( CALCULATE ( [Studio Albums], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " studio albums, share of songs per decade"
		displayFolder: Report\p04 Albums on Stage
		lineageTag: 70bb357d-ca28-46f1-a543-e04238d539ad

	/// HTML photo card (photo_zoo_tv_1992_kiel): base64 photo, gradient, number, caption, credit.
	measure 'Photo Card p04' = VAR Img = [Image Data URI] RETURN "<div style='position:relative;width:100%;height:240px;overflow:hidden;background:#0F1115'>" & IF ( NOT ISBLANK ( Img ), "<img src='" & Img & "' style='width:100%;height:240px;object-fit:cover;display:block'>" ) & "<div style='position:absolute;left:0;right:0;bottom:0;height:55%;background:linear-gradient(to bottom, rgba(15,17,21,0), rgba(15,17,21,.92) 55%)'></div><div style='position:absolute;left:20px;right:20px;bottom:12px'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:40px;line-height:1;color:#F2A93B'>" & FORMAT ( CALCULATE ( [Promoted Album Share %], dim_tour[tour_name] = "Zoo TV" ), "0%", "en-US" ) & "</div><div style='color:#ECEDEF;font-size:13px;margin-top:4px'>" & "of the songs on Zoo TV came from Achtung Baby" & "</div><div style='color:#A3A9B3;font-size:9px;margin-top:4px'>" & [Image Credit] & "</div></div></div>"
		displayFolder: Report\p04 Albums on Stage
		lineageTag: cbf9f34f-4f10-43e1-8d88-8f6eee430c36

	/// Short name of the album the tour promoted (inactive relationship, looked up by key).
	measure 'Promoted Album Label' = VAR K = SELECTEDVALUE ( dim_tour[album_promoted_key] ) RETURN IF ( NOT ISBLANK ( K ) && K <> -1, LOOKUPVALUE ( dim_album[album_label], dim_album[album_key], K ) )
		displayFolder: Report\p04 Albums on Stage
		lineageTag: 328eddd0-0045-4227-83da-d29ef325e118

	/// 1 for tours with a promoted album (table filter).
	measure 'Has Promoted Album' = VAR K = SELECTEDVALUE ( dim_tour[album_promoted_key] ) RETURN IF ( NOT ISBLANK ( K ) && K <> -1, 1, 0 )
		formatString: #,0
		displayFolder: Report\p04 Albums on Stage
		lineageTag: 5de3d5a5-8f25-47f6-a19f-46b112b6ed47

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p04 tours' = "All " & FORMAT ( CALCULATE ( [Tours with Promoted Album], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " tours with a new album: share from it"
		displayFolder: Report\p04 Albums on Stage
		lineageTag: dec21859-d916-4c5c-9e9d-707b99204897

