	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p03 guests' = "All " & FORMAT ( CALCULATE ( [Guest Artists], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " guests on stage, most frequent first"
		displayFolder: Report\p03 The Songs
		lineageTag: 58451c63-1e30-42d4-a890-2a069a5a607d

	/// HTML: page headline and intro paragraph from the model text measures (T-35).
