		displayFolder: Report\p05 Setlist Evolution
		lineageTag: 6314363b-be73-4eaa-ad60-dc19513a20f1

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p05 heatmap' = "All " & FORMAT ( CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " songs by decade, most played first (scroll for more)"
		displayFolder: Report\p05 Setlist Evolution
		lineageTag: 0d325725-8b3f-45ad-9212-1cfed23cfddc

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p05 variety' = "All " & FORMAT ( CALCULATE ( CALCULATE ( DISTINCTCOUNT ( fact_show[tour_key] ), REMOVEFILTERS ( dim_tour ) ), REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " tours, most fixed setlist first"
		displayFolder: Report\p05 Setlist Evolution
		lineageTag: 8b70dfff-0d06-4742-a634-bf375f16f7ab

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p05 openers' = "Top openers: 3 of " & FORMAT ( CALCULATE ( [Opener Songs], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " openers"
		displayFolder: Report\p05 Setlist Evolution
		lineageTag: 0be7eddb-d2f0-40d8-9bf1-9a04501feec7

	/// Rank of song_title by [Opener Count] for an exact Top N (ties broken alphabetically).
	measure 'Rank 2 song_title by Opener Count' = VAR Cur = CALCULATE ( [Opener Count], REMOVEFILTERS ( dim_date ) ) VAR Me = SELECTEDVALUE ( dim_song[song_title] ) RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Me ), COUNTROWS ( FILTER ( ALLSELECTED ( dim_song[song_title] ), VAR V = CALCULATE ( [Opener Count], REMOVEFILTERS ( dim_date ) ) RETURN NOT ISBLANK ( V ) && ( V > Cur || ( V = Cur && dim_song[song_title] < Me ) ) ) ) + 1 )
		formatString: #,0
		displayFolder: Report\p05 Setlist Evolution
		lineageTag: 2ec04ad5-ecec-4239-9394-d021fdf42ab9

	/// HTML: residency callouts on the Sphere photo.
	measure 'Residency Callouts p06' = "<div style='font-family:Segoe UI'><div style='font-size:11px;letter-spacing:1.5px;font-weight:700;color:#ECEDEF'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='16' height='16' role='img' aria-label='Sphere residency: globe'><title>Sphere residency: globe</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='17'/><path d='M8 19h32M8 29h32'/><ellipse cx='24' cy='24' rx='7' ry='17'/></g></svg> RESIDENCY · SPHERE, LAS VEGAS · 2023-24</div><div style='display:flex;gap:28px;margin-top:8px'>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:40px;line-height:1;color:#F2A93B'>" & FORMAT ( CALCULATE ( [Shows], REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () ), "#,0", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>shows</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:40px;line-height:1;color:#F2A93B'>" & FORMAT ( [Residency Songs per Show], "0", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>songs a night</div></div>" & "<div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:40px;line-height:1;color:#F2A93B'>" & FORMAT ( [Residency Achtung Baby Share %], "0%", "en-US" ) & "</div><div style='font-size:12px;color:#ECEDEF;margin-top:4px'>from Achtung Baby</div></div>" & "</div></div>"
		displayFolder: Report\p06 Sphere vs Touring
		lineageTag: fff56d3d-04bb-491b-b44c-90b88124c05b

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
