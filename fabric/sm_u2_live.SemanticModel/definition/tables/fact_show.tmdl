/// One row per real show (cancelled and duplicate setlists excluded).
table fact_show
	lineageTag: 277d222f-8dd9-48e6-8af3-581229e290ef
	sourceLineageTag: [dbo].[fact_show]

	/// Number of real shows (cancelled and duplicate setlists excluded in Silver). Q1.
	measure Shows = COUNTROWS ( fact_show )
		formatString: #,0
		displayFolder: Shows
		lineageTag: 5fca2ef8-5563-46de-bea1-868985de1df8

	/// Shows where setlist.fm lists at least one song; denominator for per-show averages. Q1, Q8.
	measure 'Shows with Setlist' = CALCULATE ( [Shows], KEEPFILTERS ( fact_show[has_setlist] = TRUE () ) )
		formatString: #,0
		displayFolder: Shows
		lineageTag: 3e1f4282-bf17-48c6-86c8-286a1f1c4ab4

	/// Distinct countries with at least one show in context. Q1, Q7.
	measure Countries = CALCULATE ( DISTINCTCOUNT ( dim_venue[country_code] ), fact_show )
		formatString: #,0
		displayFolder: Places
		lineageTag: 60aad7bc-179b-4213-b2fd-d9ad7a1c6eb6

	/// Distinct cities (city name within country) with at least one show in context. Q1, Q7.
	measure Cities = COUNTROWS ( CALCULATETABLE ( SUMMARIZE ( fact_show, dim_venue[country_code], dim_venue[city_name] ) ) )
		formatString: #,0
		displayFolder: Places
		lineageTag: d094d2da-6985-4a94-b2cd-67195af2954a

	/// Distinct venues with at least one show in context. Q1, Q7.
	measure Venues = DISTINCTCOUNT ( fact_show[venue_key] )
		formatString: #,0
		displayFolder: Places
		lineageTag: 734961c5-c853-424c-a5a6-35f4baab5c01

	/// Distinct calendar years with at least one show in context. Q1.
	measure 'Years Active' = CALCULATE ( DISTINCTCOUNT ( dim_date[year] ), fact_show )
		formatString: #,0
		displayFolder: Shows
		lineageTag: dd4c0cf8-2938-4ea9-a229-711673109d32

	/// First show in context; with a song or album filter, the first show where it was performed in full. Q3, Q7.
	measure 'First Show Date' =
			IF (
			    ISCROSSFILTERED ( dim_song ),
			    [First Played Date],
			    CALCULATE ( MIN ( dim_date[date] ), fact_show )
			)
		formatString: yyyy-mm-dd
		displayFolder: Shows
		lineageTag: ed2cc62b-edfa-4feb-9ca6-587bdfd3823e

	/// Last show in context; with a song or album filter, the last show where it was performed in full. Q3, Q7.
	measure 'Last Show Date' =
			IF (
			    ISCROSSFILTERED ( dim_song ),
			    [Last Played Date],
			    CALCULATE ( MAX ( dim_date[date] ), fact_show )
			)
		formatString: yyyy-mm-dd
		displayFolder: Shows
		lineageTag: 5afb8c4e-ee57-47e2-9e24-70d581967949

	/// UTC time the Gold tables were last rebuilt (About page).
	measure 'Last Refresh Date' = MAX ( fact_show[_built_at] )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Report\Text
		lineageTag: a21ec9a7-73b2-4e20-a844-db836b30e55d

	/// SVG markup of the tour's glyph (docs/design/images/glyph_*.svg, incl. glyph_u2_360.svg) for one tour in context, for HTML Content Secure; blank for several tours.
	measure 'Tour Icon SVG' =
			SWITCH (
			    SELECTEDVALUE ( dim_tour[tour_name] ),
			    "Early Days", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Early Days: practice amp'><title>Early Days: practice amp</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='9' y='12' width='30' height='26' rx='3'/><circle cx='24' cy='27' r='7'/><path d='M14 17h4M30 17h4'/></g></svg>",
			    "U2-3", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='U2-3: three bars'><title>U2-3: three bars</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M15 12v24M24 12v24M33 12v24'/></g></svg>",
			    "11 O'Clock Tick Tock", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='11 O&#39;Clock Tick Tock: clock at eleven'><title>11 O&#39;Clock Tick Tock: clock at eleven</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='15'/><path d='M24 24V12M24 24l-4-7'/></g></svg>",
			    "Boy", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Boy: small figure'><title>Boy: small figure</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='16' r='6'/><path d='M13 39c0-7 5-12 11-12s11 5 11 12'/></g></svg>",
			    "October Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='October: falling leaf'><title>October: falling leaf</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M14 34C14 20 24 12 36 12c0 12-8 22-22 22z'/><path d='M14 34l12-12M10 38l4-4'/></g></svg>",
			    "Pre-War Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Pre-War: flag being raised'><title>Pre-War: flag being raised</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M15 40V8'/><path d='M15 26h18l-4 5 4 5H15' stroke-dasharray='3 3'/></g></svg>",
			    "War", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='War: white flag'><title>War: white flag</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M15 40V8'/><path d='M15 10c6-3 12 3 18 0v14c-6 3-12-3-18 0'/></g></svg>",
			    "The Unforgettable Fire", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='The Unforgettable Fire: flame'><title>The Unforgettable Fire: flame</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 40c-7 0-11-5-11-11 0-8 8-11 8-19 4 3 6 7 5 11 2-1 4-3 4-6 4 4 6 9 6 14 0 6-5 11-12 11z'/></g></svg>",
			    "A Conspiracy of Hope", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='A Conspiracy of Hope: rising sun'><title>A Conspiracy of Hope: rising sun</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M10 34h28'/><path d='M15 34a9 9 0 0118 0'/><path d='M24 14v5M12 21l3 3M36 21l-3 3'/></g></svg>",
			    "Joshua Tree Promo Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Joshua Tree promo shows: rooftop'><title>Joshua Tree promo shows: rooftop</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M8 40V24h32v16'/><path d='M8 24l4-6h24l4 6'/><path d='M18 18v-4M30 18v-4'/></g></svg>",
			    "The Joshua Tree", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='The Joshua Tree Tour 1987: desert tree'><title>The Joshua Tree Tour 1987: desert tree</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 40V24'/><path d='M24 31c-4 0-8-2-8-7v-4'/><path d='M24 27c4 0 7-3 7-8v-2'/><path d='M24 24v-6'/><path d='M16 20l-4 -1'/><path d='M16 20l-3 -4'/><path d='M16 20l0 -5'/><path d='M16 20l3 -4'/><path d='M16 20l4 -1'/><path d='M31 17l-4 -1'/><path d='M31 17l-3 -4'/><path d='M31 17l0 -5'/><path d='M31 17l3 -4'/><path d='M31 17l4 -1'/><path d='M24 18l-4 -1'/><path d='M24 18l-3 -4'/><path d='M24 18l0 -5'/><path d='M24 18l3 -4'/><path d='M24 18l4 -1'/><path d='M12 40h24'/></g></svg>",
			    "Lovetown", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Lovetown: heart'><title>Lovetown: heart</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 38S10 29 10 19a7 7 0 0114-3 7 7 0 0114 3c0 10-14 19-14 19z'/></g></svg>",
			    "Zoo TV", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Zoo TV: television set'><title>Zoo TV: television set</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='8' y='16' width='32' height='22' rx='3'/><path d='M18 8l6 8 6-8'/><path d='M14 22h14'/></g></svg>",
			    "Popmart Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='PopMart: lemon'><title>PopMart: lemon</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M8 26c4-9 12-13 20-11 6 2 10 6 12 11-4 9-12 13-20 11-6-2-10-6-12-11z'/><path d='M8 26H5'/><path d='M38 21c0-5 3-8 7-9-1 5-3 8-7 9z'/></g></svg>",
			    "Elevation", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Elevation: rising chevrons'><title>Elevation: rising chevrons</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 30l12-10 12 10'/><path d='M12 40l12-10 12 10'/><path d='M12 20L24 10l12 10'/></g></svg>",
			    "How to Dismantle an Atomic Bomb Promo Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='How to Dismantle an Atomic Bomb promo shows: atom'><title>How to Dismantle an Atomic Bomb promo shows: atom</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><ellipse cx='24' cy='24' rx='16' ry='6'/><ellipse cx='24' cy='24' rx='16' ry='6' transform='rotate(60 24 24)'/><ellipse cx='24' cy='24' rx='16' ry='6' transform='rotate(-60 24 24)'/></g></svg>",
			    "Vertigo", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Vertigo: spiral'><title>Vertigo: spiral</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 24a2 2 0 012-2 4 4 0 014 4 6 6 0 01-6 6 8 8 0 01-8-8 10 10 0 0110-10 12 12 0 0112 12 14 14 0 01-14 14'/></g></svg>",
			    "U2 360°", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='U2 360&#176;: four-legged stage with a spire'><title>U2 360&#176;: four-legged stage with a spire</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 40C8 28 15 20 24 19C33 20 40 28 42 40'/><path d='M15 40C16 32 19 25 24 23C29 25 32 32 33 40'/><path d='M24 19V5'/><path d='M8 40h32'/></g></svg>",
			    "iNNOCENCE + eXPERIENCE Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Innocence + Experience: light bulb'><title>Innocence + Experience: light bulb</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M18 30c-4-3-6-7-6-11a12 12 0 0124 0c0 4-2 8-6 11v4H18z'/><path d='M19 39h10'/></g></svg>",
			    "The Joshua Tree Tour 2017", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='The Joshua Tree Tour 2017: tree in a circle'><title>The Joshua Tree Tour 2017: tree in a circle</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 40V24'/><path d='M24 31c-4 0-8-2-8-7v-4'/><path d='M24 27c4 0 7-3 7-8v-2'/><path d='M24 24v-6'/><path d='M16 20l-4 -1'/><path d='M16 20l-3 -4'/><path d='M16 20l0 -5'/><path d='M16 20l3 -4'/><path d='M16 20l4 -1'/><path d='M31 17l-4 -1'/><path d='M31 17l-3 -4'/><path d='M31 17l0 -5'/><path d='M31 17l3 -4'/><path d='M31 17l4 -1'/><path d='M24 18l-4 -1'/><path d='M24 18l-3 -4'/><path d='M24 18l0 -5'/><path d='M24 18l3 -4'/><path d='M24 18l4 -1'/><circle cx='24' cy='24' r='20'/></g></svg>",
			    "eXPERIENCE + iNNOCENCE Tour", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Experience + Innocence: eye'><title>Experience + Innocence: eye</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 24s7-11 18-11 18 11 18 11-7 11-18 11S6 24 6 24z'/><circle cx='24' cy='24' r='5'/></g></svg>",
			    "The Joshua Tree Tour 2019", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='The Joshua Tree Tour 2019: tree in a square'><title>The Joshua Tree Tour 2019: tree in a square</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 40V24'/><path d='M24 31c-4 0-8-2-8-7v-4'/><path d='M24 27c4 0 7-3 7-8v-2'/><path d='M24 24v-6'/><path d='M16 20l-4 -1'/><path d='M16 20l-3 -4'/><path d='M16 20l0 -5'/><path d='M16 20l3 -4'/><path d='M16 20l4 -1'/><path d='M31 17l-4 -1'/><path d='M31 17l-3 -4'/><path d='M31 17l0 -5'/><path d='M31 17l3 -4'/><path d='M31 17l4 -1'/><path d='M24 18l-4 -1'/><path d='M24 18l-3 -4'/><path d='M24 18l0 -5'/><path d='M24 18l3 -4'/><path d='M24 18l4 -1'/><rect x='5' y='5' width='38' height='38' rx='6'/></g></svg>",
			    "U2:UV Achtung Baby Live at Sphere", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Sphere residency: globe'><title>Sphere residency: globe</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='17'/><path d='M8 19h32M8 29h32'/><ellipse cx='24' cy='24' rx='7' ry='17'/></g></svg>",
			    "Carnival De Luz Promo", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Carnaval de luz promo: burst of light'><title>Carnaval de luz promo: burst of light</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='6'/><path d='M24 6v6M24 36v6M6 24h6M36 24h6M11 11l4 4M33 33l4 4M37 11l-4 4M15 33l-4 4'/></g></svg>",
			    "(No tour)", "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='48' height='48' role='img' aria-label='Shows outside a tour'><title>Shows outside a tour</title><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='15' stroke-dasharray='4 4'/></g></svg>"
			)
		displayFolder: Report\Icons
		lineageTag: 486363e5-844e-4e9c-9616-7fdcff85272b

	/// Tour glyph as an SVG data URI (data category Image URL) for native tables and cards.
	measure 'Tour Icon' =
			VAR Svg = [Tour Icon SVG]
			RETURN IF ( NOT ISBLANK ( Svg ), "data:image/svg+xml;utf8," & SUBSTITUTE ( Svg, "#", "%23" ) )
		displayFolder: Report\Icons
		lineageTag: 21ecae83-cdb8-42c1-833e-7587465839dd
		dataCategory: ImageUrl

	/// Base64 data URI of the one report photo in context (filter report_image[image_id] on the visual); blank when none or several.
	measure 'Image Data URI' =
			VAR Chunks = COUNTROWS ( report_image_chunk )
			RETURN
			    IF (
			        HASONEVALUE ( report_image[image_id] ) && Chunks > 0,
			        "data:" & SELECTEDVALUE ( report_image[mime_type] ) & ";base64,"
			            & CONCATENATEX ( report_image_chunk, report_image_chunk[chunk], "", report_image_chunk[chunk_no], ASC )
			    )
		displayFolder: Report\Images
		lineageTag: 2f8e6b9c-630e-4ff8-ab2e-ef51aa168db8
		dataCategory: ImageUrl

	/// Attribution (author, licence, source) of the one report photo in context, shown under the photo.
	measure 'Image Credit' = SELECTEDVALUE ( report_image[credit_text] )
		displayFolder: Report\Images
		lineageTag: d7ca98cc-7f15-4f14-940b-e65cee0c2f55

	/// Calendar year with the most shows in context (earliest year on ties). Q1.
	measure 'Busiest Year' =
			VAR Years = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dim_date[year] ), fact_show ), "@Shows", [Shows] )
			RETURN MINX ( TOPN ( 1, Years, [@Shows], DESC ), dim_date[year] )
		formatString: 0
		displayFolder: Shows
		lineageTag: 6f2c1b72-f23b-4fc3-9af5-c7f6ebda6951

	/// Shows in the busiest year in context. Q1.
	measure 'Busiest Year Shows' =
			VAR Y = [Busiest Year]
			RETURN IF ( NOT ISBLANK ( Y ), CALCULATE ( [Shows], dim_date[year] = Y ) )
		formatString: #,0
		displayFolder: Shows
		lineageTag: 981147ef-6eb6-40bb-a5b9-9a7101fa7b6b

	/// 1 for the year with the most shows among the years shown in the visual (for the accent bar), else 0. Q1.
	measure 'Is Busiest Year' =
			VAR ThisYear = [Shows]
			VAR MaxYear = MAXX ( ALLSELECTED ( dim_date[year] ), [Shows] )
			RETURN IF ( NOT ISBLANK ( ThisYear ), IF ( ThisYear = MaxYear, 1, 0 ) )
		formatString: 0
		displayFolder: Report\Text
		lineageTag: d85da8b9-358b-4de1-8bf9-e61dccb14324

	/// Shows in the one era in context minus shows in the previous era (eras sort by their year prefix); blank when no single era is selected. Q1.
	measure 'Shows vs Previous Era' =
			VAR CurrentEra = SELECTEDVALUE ( dim_tour[era] )
			VAR PreviousEra = CALCULATE ( MAX ( dim_tour[era] ), REMOVEFILTERS ( dim_tour ), dim_tour[era] < CurrentEra, NOT ISBLANK ( dim_tour[era] ) )
			RETURN IF ( NOT ISBLANK ( CurrentEra ) && NOT ISBLANK ( PreviousEra ), [Shows] - CALCULATE ( [Shows], REMOVEFILTERS ( dim_tour ), dim_tour[era] = PreviousEra ) )
		formatString: +#,0;-#,0;0
		displayFolder: Shows
		lineageTag: 69d5ae2c-081f-4a91-8792-2e147e163a6e

	/// Countries in the one era in context minus the previous era; blank when no single era is selected. Q1, Q7.
	measure 'Countries vs Previous Era' =
			VAR CurrentEra = SELECTEDVALUE ( dim_tour[era] )
			VAR PreviousEra = CALCULATE ( MAX ( dim_tour[era] ), REMOVEFILTERS ( dim_tour ), dim_tour[era] < CurrentEra, NOT ISBLANK ( dim_tour[era] ) )
			RETURN IF ( NOT ISBLANK ( CurrentEra ) && NOT ISBLANK ( PreviousEra ), [Countries] - CALCULATE ( [Countries], REMOVEFILTERS ( dim_tour ), dim_tour[era] = PreviousEra ) )
		formatString: +#,0;-#,0;0
		displayFolder: Places
		lineageTag: 78783cca-011a-4461-b70f-b88cb6ca3d55

	/// Plain sentence of the filters in effect (era, tour, years), appended to 'First glimpse' paragraphs.
	measure 'Filter Context Text' =
			VAR OneEra = SELECTEDVALUE ( dim_tour[era] )
			VAR OneTour = SELECTEDVALUE ( dim_tour[tour_name_display] )
			VAR EraText = IF ( NOT ISBLANK ( OneEra ), "Era " & OneEra )
			VAR TourText = IF ( NOT ISBLANK ( OneTour ), "Tour: " & OneTour )
			VAR FirstYear = YEAR ( CALCULATE ( MIN ( dim_date[date] ), fact_show ) )
			VAR LastYear = YEAR ( CALCULATE ( MAX ( dim_date[date] ), fact_show ) )
			VAR YearText = IF ( NOT ISBLANK ( FirstYear ), IF ( FirstYear = LastYear, FORMAT ( FirstYear, "0", "en-US" ), FORMAT ( FirstYear, "0", "en-US" ) & "-" & FORMAT ( LastYear, "0", "en-US" ) ) )
			VAR Parts = { EraText, TourText, YearText }
			RETURN
			    IF (
			        NOT ISFILTERED ( dim_tour ) && NOT ISFILTERED ( dim_date ) && NOT ISFILTERED ( dim_venue ),
			        "All shows, " & YearText,
			        CONCATENATEX ( FILTER ( Parts, NOT ISBLANK ( [Value] ) ), [Value], ", " )
			    )
		displayFolder: Report\Text
		lineageTag: 8c0f884e-8690-4f8c-99c0-2294db931737

	/// Most-performed song in context (ties: alphabetical first). Helper for text measures. Q2.
	measure 'Top Song Name' =
			VAR Songs = ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dim_song[song_title] ), fact_performance ), NOT ISBLANK ( dim_song[song_title] ) ), "@P", [Performances] )
			VAR TopP = MAXX ( Songs, [@P] )
			RETURN MINX ( FILTER ( Songs, [@P] = TopP && TopP > 0 ), dim_song[song_title] )
		displayFolder: Report\Text
		lineageTag: 046d5840-96d9-477e-b1ce-3e901cbc8335

	/// Most-performed song and its count, e.g. I Will Follow · 1,065 times. Q2.
	measure 'Top Song Text' =
			VAR Song = [Top Song Name]
			RETURN IF ( NOT ISBLANK ( Song ), Song & " · " & FORMAT ( CALCULATE ( [Performances], dim_song[song_title] = Song ), "#,0", "en-US" ) & " times" )
		displayFolder: Report\Text
		lineageTag: cba36204-5c9a-4b17-bff2-a04903cb85ae

	/// Annotation for the shows-per-year chart, e.g. 1981: 152 shows, the busiest year. Q1.
	measure 'Busiest Year Text' =
			VAR Y = [Busiest Year]
			RETURN IF ( NOT ISBLANK ( Y ), FORMAT ( Y, "0", "en-US" ) & ": " & FORMAT ( [Busiest Year Shows], "#,0", "en-US" ) & " shows, the busiest year" )
		displayFolder: Report\Text
		lineageTag: acf7c219-0105-4e82-869b-1f5ff772a64a

	/// Finding-style headline of page 1 (Q1, Q2): shows, span in years and how often the top song was played (≤ 65 characters).
	measure 'Headline p01' =
			VAR Y1 = YEAR ( [First Show Date] )
			VAR Y2 = YEAR ( [Last Show Date] )
			VAR Song = [Top Song Name]
			VAR Times = CALCULATE ( [Performances], dim_song[song_title] = Song )
			RETURN
			    FORMAT ( [Shows], "#,0", "en-US" ) & " shows in " & FORMAT ( Y2 - Y1, "0", "en-US" ) & " years; " & Song
			        & " played " & FORMAT ( Times, "#,0", "en-US" ) & " times"
		displayFolder: Report\Text
		lineageTag: cf194645-36f6-461c-ab60-d1755782713a

	/// HTML standfirst of page 1 (Q1, Q2) with the key numbers in bold and the filters in effect.
	measure 'First Glimpse p01' = "From <b>" & FORMAT ( YEAR ( [First Show Date] ), "0", "en-US" ) & "</b> to <b>" & FORMAT ( YEAR ( [Last Show Date] ), "0", "en-US" ) & "</b>: <b>" & FORMAT ( [Shows], "#,0", "en-US" ) & " shows</b> in <b>" & FORMAT ( [Countries], "#,0", "en-US" ) & " countries</b> and <b>" & FORMAT ( [Cities], "#,0", "en-US" ) & " cities</b>, with <b>" & FORMAT ( [Distinct Songs], "#,0", "en-US" ) & " different songs</b>. The busiest year was <b>" & FORMAT ( [Busiest Year], "0", "en-US" ) & "</b>, with <b>" & FORMAT ( [Busiest Year Shows], "#,0", "en-US" ) & " shows</b>. <span style='color:#A3A9B3'>(" & [Filter Context Text] & ")</span>"
		displayFolder: Report\Text
		lineageTag: e07eb2a9-cbbe-459c-be20-c00d6f810c92

	/// Finding-style headline of page 2 (Q7): the city with the most shows.
	measure 'Headline p02' =
			VAR Cities = ADDCOLUMNS ( CALCULATETABLE ( SUMMARIZE ( fact_show, dim_venue[country_name], dim_venue[city_name] ) ), "@S", [Shows] )
			VAR TopS = MAXX ( Cities, [@S] )
			VAR City = MINX ( FILTER ( Cities, [@S] = TopS ), dim_venue[city_name] )
			RETURN City & " hosted " & FORMAT ( TopS, "#,0", "en-US" ) & " shows, more than any other city"
		displayFolder: Report\Text
		lineageTag: 6105673e-4557-4996-9eda-e539f1ed27e4

	/// HTML standfirst of page 2 (Q7): countries, continents, top country with its share, home city span.
	measure 'First Glimpse p02' =
			VAR Countries = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dim_venue[country_name] ), fact_show ), "@S", [Shows] )
			VAR TopS = MAXX ( Countries, [@S] )
			VAR Country = MINX ( FILTER ( Countries, [@S] = TopS ), dim_venue[country_name] )
			VAR Continents = CALCULATE ( DISTINCTCOUNT ( dim_venue[continent] ), fact_show )
			RETURN
			    "<b>" & FORMAT ( [Shows], "#,0", "en-US" ) & " shows</b> in <b>" & FORMAT ( [Countries], "#,0", "en-US" ) & " countries</b> on <b>" & FORMAT ( Continents, "0", "en-US" ) & " continents</b>. <b>" & Country & "</b> alone had <b>" & FORMAT ( TopS, "#,0", "en-US" ) & "</b> (" & FORMAT ( DIVIDE ( TopS, [Shows] ), "0%", "en-US" ) & "), in <b>" & FORMAT ( CALCULATE ( [Cities], dim_venue[country_name] = Country ), "#,0", "en-US" ) & " cities</b>. <span style='color:#A3A9B3'>(" & [Filter Context Text] & ")</span>"
		displayFolder: Report\Text
		lineageTag: 85ad2d2d-1b27-4a78-af46-53e533f276e4

	/// Share of full performances taken by the ten most-performed songs in context. Q2.
	measure 'Top 10 Songs Share %' =
			VAR Songs = ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dim_song[song_key] ), fact_performance ), dim_song[song_key] <> -1 ), "@P", [Performances] )
			RETURN DIVIDE ( SUMX ( TOPN ( 10, Songs, [@P], DESC ), [@P] ), [Performances] )
		formatString: #,0.0%
		displayFolder: Songs
		lineageTag: 3c8b89ad-7c2d-4c0f-8a78-ed125acf59da

	/// Finding-style headline of page 3 (Q2): concentration of the setlist in ten songs.
	measure 'Headline p03' = "Ten songs make up " & FORMAT ( [Top 10 Songs Share %], "0%", "en-US" ) & " of everything they played"
		displayFolder: Report\Text
		lineageTag: f35139b7-c1ad-47cf-b0ac-1648414c496e

	/// HTML standfirst of page 3 (Q2, Q3): songs played, staples, one-offs and retired songs.
	measure 'First Glimpse p03' =
			VAR Songs = ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dim_song[song_key] ), fact_performance ), dim_song[song_key] <> -1 ), "@P", [Performances], "@R", [Is Retired] )
			VAR Played = COUNTROWS ( FILTER ( Songs, [@P] > 0 ) )
			VAR Staples = COUNTROWS ( FILTER ( Songs, [@P] >= 50 ) )
			VAR Once = COUNTROWS ( FILTER ( Songs, [@P] = 1 ) )
			VAR Retired = COUNTROWS ( FILTER ( Songs, [@P] > 0 && [@R] = 1 ) )
			RETURN
			    "<b>" & FORMAT ( Played, "#,0", "en-US" ) & " songs</b> were played in full: <b>" & FORMAT ( Staples, "#,0", "en-US" ) & "</b> of them 50 times or more, <b>" & FORMAT ( Once, "#,0", "en-US" ) & "</b> only once. <b>" & FORMAT ( Retired, "#,0", "en-US" ) & "</b> have not been played for ten years or more. <span style='color:#A3A9B3'>(" & [Filter Context Text] & ")</span>"
		displayFolder: Report\Text
		lineageTag: df8ae959-b6c6-4f91-aedb-7364c18cea9a

	/// Finding-style headline of page 4 (Q5): share of 1980s-album songs in the 2015-2019 setlists (≤ 65 characters).
	measure 'Headline p04' =
			VAR Share = CALCULATE ( [Album Share %], REMOVEFILTERS ( dim_tour ), dim_tour[era] = "2015-2019 Innocence and Experience", dim_album[release_decade_group] = "1980s albums" )
			RETURN "The 1980s albums still filled " & FORMAT ( Share, "0%", "en-US" ) & " of the 2015-2019 setlists"
		displayFolder: Report\Text
		lineageTag: 8755a020-2887-4378-a2a3-c0866e836e6d

	/// HTML standfirst of page 4 (Q4, Q5): overall 1980s share, promoted-album share, Zoo TV example.
	measure 'First Glimpse p04' =
			VAR Eighties = CALCULATE ( [Album Share %], dim_album[release_decade_group] = "1980s albums" )
			VAR Promoted = [Promoted Album Share %]
			VAR Zoo = CALCULATE ( [Promoted Album Share %], REMOVEFILTERS ( dim_tour ), dim_tour[tour_name] = "Zoo TV" )
			RETURN
			    "Every new album gets its moment: on tours that promoted one, <b>" & FORMAT ( Promoted, "0%", "en-US" ) & "</b> of the songs came from it (<b>" & FORMAT ( Zoo, "0%", "en-US" ) & "</b> Achtung Baby on Zoo TV). Over the whole career, <b>" & FORMAT ( Eighties, "0%", "en-US" ) & "</b> of all songs played come from the 1980s albums. <span style='color:#A3A9B3'>(" & [Filter Context Text] & ")</span>"
		displayFolder: Report\Text
		lineageTag: 1c3d7acd-e9b2-4073-9a72-d379e3487f71

	/// Chart annotation on page 4 (Q5): 1980s-album share on the 2017 Joshua Tree anniversary tour.
	measure 'Annotation p04' = "2017: " & FORMAT ( CALCULATE ( [Album Share %], REMOVEFILTERS ( dim_tour ), dim_tour[tour_name] = "The Joshua Tree Tour 2017", dim_album[release_decade_group] = "1980s albums" ), "0%", "en-US" ) & " of the set came from the 1980s albums"
		displayFolder: Report\Text
		lineageTag: 0b38b07f-30f6-4491-b9fb-9eb21c2df52b

	/// Finding-style headline of page 5 (Q6): the tour (40+ shows) with the most fixed setlist (≤ 65 characters).
	measure 'Headline p05' =
			VAR Tours = ADDCOLUMNS ( FILTER ( ALL ( dim_tour[tour_name_display] ), CALCULATE ( [Shows] ) >= 40 ), "@V", CALCULATE ( [Setlist Variety] ) )
			VAR MinV = MINX ( Tours, [@V] )
			VAR Tour = MINX ( FILTER ( Tours, [@V] = MinV ), dim_tour[tour_name_display] )
			RETURN
			    Tour & " ran on rails: " & FORMAT ( CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_tour ), dim_tour[tour_name_display] = Tour ), "0", "en-US" ) & " songs, " & FORMAT ( CALCULATE ( [Avg Songs per Show], REMOVEFILTERS ( dim_tour ), dim_tour[tour_name_display] = Tour ), "0.0", "en-US" ) & " a night"
		displayFolder: Report\Text
		lineageTag: 54a7bd81-e101-4012-b184-0e3b26a5f565

	/// HTML standfirst of page 5 (Q6, Q8): how to read the heatmap, songs per night and songs per tour on the tours with 40+ shows since 1992.
	measure 'First Glimpse p05' =
			VAR BigTours = FILTER ( ALL ( dim_tour[tour_name_display], dim_tour[first_show_date] ), CALCULATE ( [Shows] ) >= 40 && YEAR ( dim_tour[first_show_date] ) >= 1992 )
			VAR SongsPerNight = CALCULATE ( [Avg Songs per Show], REMOVEFILTERS ( dim_tour ), BigTours )
			VAR MinPool = MINX ( BigTours, CALCULATE ( [Distinct Songs] ) )
			VAR MaxPool = MAXX ( BigTours, CALCULATE ( [Distinct Songs] ) )
			RETURN
			    "Each row is a song, each column a decade; brighter means played more. Since 1992 a big tour night held about <b>" & FORMAT ( SongsPerNight, "0", "en-US" ) & " songs</b>, drawn from <b>" & FORMAT ( MinPool, "0", "en-US" ) & " to " & FORMAT ( MaxPool, "0", "en-US" ) & " songs</b> per tour. <span style='color:#A3A9B3'>(" & [Filter Context Text] & ")</span>"
		displayFolder: Report\Text
		lineageTag: 6120c5b3-c34c-466d-b602-701e7a345692

	/// Finding-style headline of page 6 (Q10): Achtung Baby share at the Sphere vs. the compared tours (≤ 65 characters).
	measure 'Headline p06' = "At the Sphere, Achtung Baby was " & FORMAT ( [Residency Achtung Baby Share %], "0%", "en-US" ) & " of each night vs " & FORMAT ( [Touring Achtung Baby Share %], "0%", "en-US" ) & " touring"
		displayFolder: Report\Text
		lineageTag: 22c1c20e-68e6-410e-af57-10375775eb88

	/// HTML standfirst of page 6 (Q10): residency nights, songs per night and song pool vs. the compared tours.
	measure 'First Glimpse p06' =
			VAR ResShows = CALCULATE ( [Shows], REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () )
			VAR Compare = IF ( ISFILTERED ( dim_tour[tour_name_display] ), "the selected tours", "the four 2015-2019 tours" )
			RETURN
			    "<b>" & FORMAT ( ResShows, "0", "en-US" ) & " nights</b> in one room: <b>" & FORMAT ( [Residency Songs per Show], "0.0", "en-US" ) & " songs</b> a night from a pool of <b>" & FORMAT ( [Residency Distinct Songs], "0", "en-US" ) & "</b>, against <b>" & FORMAT ( [Touring Songs per Show], "0.0", "en-US" ) & "</b> from <b>" & FORMAT ( [Touring Distinct Songs], "0", "en-US" ) & "</b> on " & Compare & "."
		displayFolder: Report\Text
		lineageTag: 6beda19c-0b39-4e4d-847f-58f55081ac11

	/// Annotation on page 6 (Q10): Achtung Baby share difference, residency minus touring, in points.
	measure 'Annotation p06' = FORMAT ( [Difference Achtung Baby Share (pp)], "+0;-0", "en-US" ) & " points of Achtung Baby compared with touring"
		displayFolder: Report\Text
		lineageTag: 31d8490d-da95-489d-964b-37b521331fe3

	/// Tours in context that promoted an album (seeds/tours.csv). Q4.
	measure 'Tours with Promoted Album' = COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( dim_tour[tour_key] ), fact_show ), CALCULATE ( MAX ( dim_tour[album_promoted_key] ) ) <> -1 ) )
		formatString: #,0
		displayFolder: Tours
		lineageTag: 19e96d8d-6ad0-47ce-87fa-674fd2792d24

	/// Studio albums in the catalog (15: Boy to Carnaval de luz; Songs of Surrender is a re-recording). Q5.
	measure 'Studio Albums' = CALCULATE ( COUNTROWS ( dim_album ), KEEPFILTERS ( dim_album[is_studio] = TRUE () ) )
		formatString: #,0
		displayFolder: Albums
		lineageTag: 256feba0-b738-4147-8792-3b045185204f

	/// HTML: page headline and intro paragraph from the model text measures (T-35).
	measure 'Header p01' = "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-size:32px;line-height:1.1;color:#ECEDEF;font-weight:600;max-height:72px;overflow:hidden'>" & [Headline p01] & "</div><div style='font-family:Segoe UI;font-size:12.5px;line-height:1.5;color:#A3A9B3;margin-top:8px;max-height:57px;overflow:hidden'>" & [First Glimpse p01] & "</div>"
		displayFolder: Report\p01 Overview
		lineageTag: 04cbb8a2-7a8e-4b61-836d-c619dc29f360

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Header p01 · p01_headline' = "<div style='height:144px;overflow:hidden'>" & [Header p01] & "</div>"
		displayFolder: Report\p01 Overview
		lineageTag: 74e2522e-b962-4c3a-adae-99236dd9487c

	/// HTML: three KPI tiles (icon, number, delta vs previous era) for HTML Content Secure.
	measure 'KPI Tiles p01' = "<div style='display:flex;gap:28px'>" & "<div style='display:flex;gap:10px;align-items:flex-start'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='28' height='28' aria-hidden='true'><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 16h36v6a4 4 0 000 8v6H6v-6a4 4 0 000-8z'/><path d='M30 16v20' stroke-dasharray='2 3'/></g></svg><div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:46px;line-height:1;color:#F2A93B'>" & FORMAT ( [Shows], "#,0", "en-US" ) & "</div><div style='color:#ECEDEF;font-size:13px'>shows</div><div style='font-size:11px;font-weight:600;color:" & IF ( [Shows vs Previous Era] > 0, "#93C47D", IF ( [Shows vs Previous Era] < 0, "#E06666", "#A3A9B3" ) ) & "'>" & IF ( ISBLANK ( [Shows vs Previous Era] ), "all eras", IF ( [Shows vs Previous Era] > 0, "▲ +", "▼ " ) & FORMAT ( [Shows vs Previous Era], "#,0", "en-US" ) & " vs previous era" ) & "</div></div></div>" & "<div style='display:flex;gap:10px;align-items:flex-start'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='28' height='28' aria-hidden='true'><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M18 36V12l20-4v24'/><circle cx='13' cy='36' r='5'/><circle cx='33' cy='32' r='5'/></g></svg><div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:46px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Distinct Songs], "#,0", "en-US" ) & "</div><div style='color:#ECEDEF;font-size:13px'>different songs</div><div style='font-size:11px;font-weight:600;color:" & IF ( [Distinct Songs vs Previous Era] > 0, "#93C47D", IF ( [Distinct Songs vs Previous Era] < 0, "#E06666", "#A3A9B3" ) ) & "'>" & IF ( ISBLANK ( [Distinct Songs vs Previous Era] ), "all eras", IF ( [Distinct Songs vs Previous Era] > 0, "▲ +", "▼ " ) & FORMAT ( [Distinct Songs vs Previous Era], "#,0", "en-US" ) & " vs previous era" ) & "</div></div></div>" & "<div style='display:flex;gap:10px;align-items:flex-start'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='28' height='28' aria-hidden='true'><g fill='none' stroke='#ECEDEF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 42s-13-12-13-23a13 13 0 0126 0c0 11-13 23-13 23z'/><circle cx='24' cy='19' r='5'/></g></svg><div><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:46px;line-height:1;color:#ECEDEF'>" & FORMAT ( [Countries], "#,0", "en-US" ) & "</div><div style='color:#ECEDEF;font-size:13px'>countries</div><div style='font-size:11px;font-weight:600;color:" & IF ( [Countries vs Previous Era] > 0, "#93C47D", IF ( [Countries vs Previous Era] < 0, "#E06666", "#A3A9B3" ) ) & "'>" & IF ( ISBLANK ( [Countries vs Previous Era] ), "all eras", IF ( [Countries vs Previous Era] > 0, "▲ +", "▼ " ) & FORMAT ( [Countries vs Previous Era], "#,0", "en-US" ) & " vs previous era" ) & "</div></div></div>" & "</div>"
		displayFolder: Report\p01 Overview
		lineageTag: 68ee37e6-e153-4a85-950a-c0252bbd7674

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'KPI Tiles p01 · p01_kpi_tiles' = "<div style='height:88px;overflow:hidden'>" & [KPI Tiles p01] & "</div>"
		displayFolder: Report\p01 Overview
		lineageTag: 8603475e-0fc3-4b57-ad86-0a76c3435943

	/// Hex colour for conditional formatting (presentation only).
	measure 'Top Song Bar Color' = IF ( RANKX ( ALLSELECTED ( dim_song[song_title] ), [Performances] ) = 1, "#F2A93B", "#6FA8DC" )
		displayFolder: Report\p01 Overview
		lineageTag: 1e93680a-e8ed-4069-b55b-da6ae4735d68

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p01 top10' = "The ten songs played most, of " & FORMAT ( CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & ""
		displayFolder: Report\p01 Overview
		lineageTag: 11c16048-33c5-47d7-9e2e-2aa65c397adc

	/// Rank of song_title by [Performances] for an exact Top N (ties broken alphabetically).
	measure 'Rank 1 song_title by Performances' = VAR Cur = CALCULATE ( [Performances], REMOVEFILTERS ( dim_date ) ) VAR Me = SELECTEDVALUE ( dim_song[song_title] ) RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Me ), COUNTROWS ( FILTER ( ALLSELECTED ( dim_song[song_title] ), VAR V = CALCULATE ( [Performances], REMOVEFILTERS ( dim_date ) ) RETURN NOT ISBLANK ( V ) && ( V > Cur || ( V = Cur && dim_song[song_title] < Me ) ) ) ) + 1 )
		formatString: #,0
		displayFolder: Report\p01 Overview
		lineageTag: 5c489548-7ae1-4ace-ab64-d80591789388

	/// HTML: page headline and intro paragraph from the model text measures (T-35).
	measure 'Header p02' = "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-size:32px;line-height:1.1;color:#ECEDEF;font-weight:600;max-height:72px;overflow:hidden'>" & [Headline p02] & "</div><div style='font-family:Segoe UI;font-size:12.5px;line-height:1.5;color:#A3A9B3;margin-top:8px;max-height:57px;overflow:hidden'>" & [First Glimpse p02] & "</div>"
		displayFolder: Report\p02 On the Road
		lineageTag: 68f2c512-57a6-430a-9f70-b7778151b8d3

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Header p02 · p02_headline' = "<div style='height:88px;overflow:hidden'>" & [Header p02] & "</div>"
		displayFolder: Report\p02 On the Road
		lineageTag: 270913ad-e1e8-489b-b44c-cc43a3c594b7

	/// HTML: the most-visited city and its number of shows.
	measure 'Top City Card p02' = "<div style='font-family:Segoe UI'><div style='font-family:DIN,Bahnschrift,Segoe UI;font-weight:600;font-size:40px;line-height:1;color:#F2A93B'>" & MAXX ( TOPN ( 1, VALUES ( dim_venue[city_name] ), [Shows] ), dim_venue[city_name] ) & " · " & FORMAT ( MAXX ( TOPN ( 1, VALUES ( dim_venue[city_name] ), [Shows] ), [Shows] ), "#,0", "en-US" ) & "</div><div style='color:#ECEDEF;font-size:13px;margin-top:4px'>shows in the most-visited city (photo: Croke Park, Dublin, 1987)</div></div>"
		displayFolder: Report\p02 On the Road
		lineageTag: 83f61c35-80ec-44de-93be-92d9ef320311

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Top City Card p02 · p02_top_city' = "<div style='height:68px;overflow:hidden'>" & [Top City Card p02] & "</div>"
		displayFolder: Report\p02 On the Road
		lineageTag: 4cf38213-0de4-47b4-82ab-c3e3b2ab1de0

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p02 cities' = "All " & FORMAT ( CALCULATE ( [Cities], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " cities, most shows first"
		displayFolder: Report\p02 On the Road
		lineageTag: f2edd955-2ada-4f81-a04e-f0a7768006c4

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p02 shows' = "" & FORMAT ( CALCULATE ( [Shows], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " shows · right-click one for its setlist"
		displayFolder: Report\p02 On the Road
		lineageTag: 056aa253-d434-4453-85d0-87a97e3b4058

	/// Bound to model measure [Top Song Text] (T-35); kept so the text cards keep their binding.
	measure 'ph Top Song Text' = [Top Song Text]
		displayFolder: Report\p03 The Songs
		lineageTag: f2dcaccb-3e43-41b1-b5d5-095668abf7eb

	/// Typography wrapper (presentation only).
	measure 'ph Top Song Text · p03_top_song_callout' = "<div style='font-family:DIN, Bahnschrift, Segoe UI, sans-serif;font-size:28px;line-height:1.1;color:#F2A93B;font-weight:600;max-height:68px;overflow:hidden'>" & [ph Top Song Text] & "</div>"
		displayFolder: Report\p03 The Songs
		lineageTag: a6caa934-61a2-42ac-bcd0-90941fdf39c3

	/// HTML: page headline and intro paragraph from the model text measures (T-35).
	measure 'Header p03' = "<div style='font-family:DIN,Bahnschrift,Segoe UI;font-size:32px;line-height:1.1;color:#ECEDEF;font-weight:600;max-height:72px;overflow:hidden'>" & [Headline p03] & "</div><div style='font-family:Segoe UI;font-size:12.5px;line-height:1.5;color:#A3A9B3;margin-top:8px;max-height:57px;overflow:hidden'>" & [First Glimpse p03] & "</div>"
		displayFolder: Report\p03 The Songs
		lineageTag: e4eff346-e7e8-4dde-ac9b-29c79008a4f3

	/// Clipping wrapper so the HTML visual never scrolls (presentation only).
	measure 'Header p03 · p03_headline' = "<div style='height:144px;overflow:hidden'>" & [Header p03] & "</div>"
		displayFolder: Report\p03 The Songs
		lineageTag: 52ecf3e0-89a9-4edc-ba20-50d8646235c9

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p03 songs' = "All " & FORMAT ( CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " songs, most played first · right-click for the story"
		displayFolder: Report\p03 The Songs
		lineageTag: b5279834-928e-435a-bbc6-b2fde0faef3a

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p03 rarities' = "All " & FORMAT ( CALCULATE ( [Rarities], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " rarities (played twice or less), most recent first"
		displayFolder: Report\p03 The Songs
		lineageTag: 3166edea-8f0d-4441-8dfe-4cdecd87e5ff

	/// Visual title with the Top N cut and the total (presentation only).
	measure 'Title p03 covers' = "All " & FORMAT ( CALCULATE ( [Cover Songs], REMOVEFILTERS ( dim_song[song_title] ), REMOVEFILTERS ( dim_song[full_performances] ), REMOVEFILTERS ( dim_venue[city_name] ), REMOVEFILTERS ( fact_performance[guest_artist] ), REMOVEFILTERS ( dim_tour[tour_name_display] ) ), "#,0", "en-US" ) & " other people's songs, most played first"
		displayFolder: Report\p03 The Songs
