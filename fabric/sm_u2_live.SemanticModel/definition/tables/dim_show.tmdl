/// One row per show with label, setlist.fm link and notes (drill-through target).
table dim_show
	lineageTag: 71de0af7-f0d4-49d4-ac86-ecddab9cdc65
	sourceLineageTag: [dbo].[dim_show]

	/// Surrogate key (SHA2_256 of setlist_id); -1 = Unknown.
	column show_key
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 4f142cc2-367b-4fdf-a926-dd4456a35c68
		sourceLineageTag: show_key
		summarizeBy: none
		sourceColumn: show_key

		annotation SummarizationSetBy = Automatic

	/// setlist.fm setlist id.
	column setlist_id
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: bec18e53-3247-42d4-abd9-594c992b4e03
		sourceLineageTag: setlist_id
		summarizeBy: none
		sourceColumn: setlist_id

		annotation SummarizationSetBy = Automatic

	/// Date, city and venue of the show, e.g. 1987-09-11 · Philadelphia · JFK Stadium.
	column show_label
		dataType: string
		lineageTag: a1bcfbe1-0c8d-4323-8415-2aa8a8586475
		sourceLineageTag: show_label
		summarizeBy: none
		sourceColumn: show_label

		annotation SummarizationSetBy = Automatic

	/// Link to the show's page on setlist.fm.
	column setlist_url
		dataType: string
		lineageTag: e6ba6b64-15ec-4ee6-9947-fcc57eedda3f
		sourceLineageTag: setlist_url
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: setlist_url

