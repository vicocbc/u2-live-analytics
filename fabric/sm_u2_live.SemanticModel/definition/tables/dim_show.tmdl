	/// Show notes from setlist.fm, as written there.
	column show_info
		dataType: string
		lineageTag: 808951d6-2a31-4eac-8d48-7f2b503f8d82
		sourceLineageTag: show_info
		summarizeBy: none
		sourceColumn: show_info

		annotation SummarizationSetBy = Automatic

	column _built_at
		dataType: dateTime
		isHidden
		formatString: General Date
		isAvailableInMdx: false
		lineageTag: fd3a1ada-1eb2-45dd-8ca4-57be26be7d4e
		sourceLineageTag: _built_at
		summarizeBy: none
		sourceColumn: _built_at

