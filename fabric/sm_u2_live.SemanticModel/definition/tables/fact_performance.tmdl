		isAvailableInMdx: false
		lineageTag: c7ebf054-6093-42a2-a1f1-7facec0458eb
		sourceLineageTag: tour_key
		summarizeBy: none
		sourceColumn: tour_key

		annotation SummarizationSetBy = Automatic

	/// Foreign key to dim_venue.
	column venue_key
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 10ae29bf-0379-41f4-94f8-8ce2a6e299d9
		sourceLineageTag: venue_key
		summarizeBy: none
		sourceColumn: venue_key

		annotation SummarizationSetBy = Automatic

	/// 1-based position of the song in the show (tapes included).
	column setlist_position
		dataType: int64
		formatString: 0
		lineageTag: 0aa724e5-e054-41e7-a3d4-c7db22f7878a
		sourceLineageTag: setlist_position
		summarizeBy: none
		sourceColumn: setlist_position

		annotation SummarizationSetBy = Automatic

	/// Main set, Encore 1, Encore 2, or the set name from setlist.fm.
	column set_name
		dataType: string
		lineageTag: 8d4f7d1a-2689-4d8f-bf97-cbfa02660c20
		sourceLineageTag: set_name
		summarizeBy: none
		sourceColumn: set_name

		annotation SummarizationSetBy = Automatic

	/// True when the song was played in an encore.
	column is_encore
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 22785fe9-0834-4721-9412-6adc2eb9aee8
		sourceLineageTag: is_encore
		summarizeBy: none
		sourceColumn: is_encore

		annotation SummarizationSetBy = Automatic

	/// True for the first non-tape song of the show.
	column is_opener
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: bbe79545-6226-4637-b2a0-4aed61a11f77
		sourceLineageTag: is_opener
		summarizeBy: none
		sourceColumn: is_opener

		annotation SummarizationSetBy = Automatic

	/// True for the last non-tape song of the show.
	column is_closer
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e1411b27-a1c6-4b97-af46-a638f0bd3cea
		sourceLineageTag: is_closer
		summarizeBy: none
		sourceColumn: is_closer

		annotation SummarizationSetBy = Automatic

	/// Song played only in part (excluded by default).
	column is_snippet
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 7f5060dd-20fe-4568-94bc-2fa2eae6b6fa
		sourceLineageTag: is_snippet
		summarizeBy: none
		sourceColumn: is_snippet

		annotation SummarizationSetBy = Automatic

	/// Recorded intro/outro, not played live (excluded by default).
	column is_tape
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: a6e3a2b8-fa58-4567-92e3-0d887cfe50d9
		sourceLineageTag: is_tape
		summarizeBy: none
		sourceColumn: is_tape

		annotation SummarizationSetBy = Automatic

	/// Lead-in fragment such as The Cry (excluded by default).
	column is_fragment
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 1336062e-ccd9-4051-b0da-17983d9916f5
		sourceLineageTag: is_fragment
		summarizeBy: none
		sourceColumn: is_fragment

		annotation SummarizationSetBy = Automatic

	/// setlist.fm flags the song as a cover.
	column is_cover
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: d3f884c4-f9a2-4362-ab1d-106e462efc28
		sourceLineageTag: is_cover
		summarizeBy: none
		sourceColumn: is_cover

		annotation SummarizationSetBy = Automatic

	/// A guest artist joined the band for the song.
	column has_guest
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 88f980f3-0948-47af-8186-9ac4222b4d78
		sourceLineageTag: has_guest
		summarizeBy: none
		sourceColumn: has_guest

		annotation SummarizationSetBy = Automatic

	/// Guest artist as written on setlist.fm.
	column guest_artist
		dataType: string
		lineageTag: 2937e30b-f40e-40f9-bdfe-30977c0ed87c
		sourceLineageTag: guest_artist
		summarizeBy: none
		sourceColumn: guest_artist

		annotation SummarizationSetBy = Automatic

	/// First full performance of the song (same-day ties broken by setlist id).
	column is_live_debut
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
