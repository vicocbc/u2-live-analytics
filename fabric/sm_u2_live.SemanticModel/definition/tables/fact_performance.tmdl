/// One row per song performed at a show (setlist.fm), snippets, tapes and fragments included and flagged.
table fact_performance
	lineageTag: 10009ca0-b778-45c3-abe2-c3fa463b9816
	sourceLineageTag: [dbo].[fact_performance]

	/// Songs performed in full: snippets, tapes and fragments (The Cry) excluded; base measure for every song-level number. Q2.
	measure Performances =
			CALCULATE (
			    COUNTROWS ( fact_performance ),
			    KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ),
			    KEEPFILTERS ( fact_performance[is_tape] = FALSE () ),
			    KEEPFILTERS ( fact_performance[is_fragment] = FALSE () )
			)
		formatString: #,0
		displayFolder: Songs
		lineageTag: 8e83fb42-009e-401f-86c9-8d3518622b43

	/// Every setlist entry with a name, for reconciling with Silver on the About page; not for analysis.
	measure 'All Performances incl. Snippets, Tapes and Fragments' = COUNTROWS ( fact_performance )
		formatString: #,0
		displayFolder: Songs\Data quality
		lineageTag: e8f6867b-e6a3-4b7c-aa96-9d41dbf38c10

	/// Different songs performed in full in context (unmapped setlist names excluded). Q2, Q6.
	measure 'Distinct Songs' = CALCULATE ( DISTINCTCOUNT ( fact_performance[song_key] ), KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ), KEEPFILTERS ( fact_performance[is_tape] = FALSE () ), KEEPFILTERS ( fact_performance[is_fragment] = FALSE () ), KEEPFILTERS ( fact_performance[song_key] <> -1 ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: 51fb8260-5c91-4586-8842-517db6e75c72

	/// Shows where the songs in context were performed in full (use instead of Shows when a song or album filters the visual). Q2, Q3.
	measure 'Shows Played' = CALCULATE ( DISTINCTCOUNT ( fact_performance[show_key] ), KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ), KEEPFILTERS ( fact_performance[is_tape] = FALSE () ), KEEPFILTERS ( fact_performance[is_fragment] = FALSE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: f2d957a9-ec0c-40d5-87c0-39491a079a61

	/// Full performances per show with a setlist. Q8.
	measure 'Avg Songs per Show' = DIVIDE ( [Performances], [Shows with Setlist] )
		formatString: #,0.0
		displayFolder: Songs
		lineageTag: f8c87d24-c1da-42d3-9b44-d904212ae847

	/// First full performances of songs in context (the fragment's debut is excluded with it). Q3.
	measure 'Live Debuts' = CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[is_live_debut] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: 8127f601-18a4-48ad-9a36-6a2f139aa7bb

	/// Songs with only one or two full performances in context. Q2.
	measure Rarities =
			VAR SongsInContext =
			    ADDCOLUMNS ( KEEPFILTERS ( VALUES ( dim_song[song_key] ) ), "@Performances", [Performances] )
			RETURN
			    COUNTROWS ( FILTER ( SongsInContext, dim_song[song_key] <> -1 && [@Performances] >= 1 && [@Performances] <= 2 ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: b814d8c0-7198-4501-9ee8-118a300b18c7

	/// Date of the first full performance in context. Q3.
	measure 'First Played Date' = CALCULATE ( MIN ( dim_date[date] ), CALCULATETABLE ( fact_performance, KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ), KEEPFILTERS ( fact_performance[is_tape] = FALSE () ), KEEPFILTERS ( fact_performance[is_fragment] = FALSE () ) ) )
		formatString: yyyy-mm-dd
		displayFolder: Songs
		lineageTag: f79ae576-5812-416a-ad24-ac5790584343

	/// Date of the last full performance in context. Q3.
	measure 'Last Played Date' = CALCULATE ( MAX ( dim_date[date] ), CALCULATETABLE ( fact_performance, KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ), KEEPFILTERS ( fact_performance[is_tape] = FALSE () ), KEEPFILTERS ( fact_performance[is_fragment] = FALSE () ) ) )
		formatString: yyyy-mm-dd
		displayFolder: Songs
		lineageTag: 81abc503-ba91-4610-a150-b3839d467d3d

	/// Current year minus the year of the last full performance; blank unless exactly one song is in context. Q3.
	measure 'Years Since Last Played' =
			VAR LastPlayed = [Last Played Date]
			RETURN IF ( HASONEVALUE ( dim_song[song_key] ) && NOT ISBLANK ( LastPlayed ), YEAR ( TODAY () ) - YEAR ( LastPlayed ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: 32e9211d-5246-4867-93ab-a9b1b1872f4b

	/// 1 when the song has not been performed in full for 10 or more calendar years (the report's definition of retired), else 0. Q3.
	measure 'Is Retired' =
			VAR Years = [Years Since Last Played]
			RETURN IF ( NOT ISBLANK ( Years ), IF ( Years >= 10, 1, 0 ) )
		formatString: 0
		displayFolder: Songs
		lineageTag: 4a15588f-3091-4ee4-a3e6-7567a77502ff

	/// Share of full performances whose song's first album is the album the tour promoted, over tours that promoted one. Q4.
	measure 'Promoted Album Share %' =
			VAR Tours =
			    ADDCOLUMNS (
			        KEEPFILTERS ( VALUES ( dim_tour[tour_key] ) ),
			        "@Album", CALCULATE ( MAX ( dim_tour[album_promoted_key] ) )
			    )
			VAR ToursWithAlbum = FILTER ( Tours, [@Album] <> -1 )
			VAR FromPromoted =
			    SUMX ( ToursWithAlbum, CALCULATE ( [Performances], TREATAS ( { [@Album] }, dim_album[album_key] ) ) )
			VAR AllPerformances =
			    SUMX ( ToursWithAlbum, CALCULATE ( [Performances] ) )
			RETURN DIVIDE ( FromPromoted, AllPerformances )
		formatString: #,0.0%
		displayFolder: Albums
		lineageTag: 77e8c030-07b8-4e49-a689-b4cb5a1757fd

	/// Share of full performances in context that come from the album(s) in context (by the song's first album). Q5.
	measure 'Album Share %' = DIVIDE ( [Performances], CALCULATE ( [Performances], REMOVEFILTERS ( dim_album ) ) )
		formatString: #,0.0%
		displayFolder: Albums
		lineageTag: 432d6bb6-fe38-4c8c-97ea-1844466fc966

	/// Share of full performances from Achtung Baby (the album played in full at the Sphere). Q10.
	measure 'Achtung Baby Share %' = DIVIDE ( CALCULATE ( [Performances], KEEPFILTERS ( dim_album[album_title] = "Achtung Baby" ), KEEPFILTERS ( dim_album[is_studio] = TRUE () ) ), [Performances] )
		formatString: #,0.0%
		displayFolder: Albums
		lineageTag: 237ba1af-ab37-4e97-a6e3-14caae6598eb

	/// Distinct songs divided by songs per show: 1 means the same setlist every night, higher means more rotation. Q6.
	measure 'Setlist Variety' = DIVIDE ( [Distinct Songs], [Avg Songs per Show] )
		formatString: #,0.0
		displayFolder: Tours
		lineageTag: 593e419a-54eb-4690-aa33-600d967ba70d

	/// Full performances of songs written by other artists (dim_song[is_original] = false, so Passengers songs, Silver and Gold and North and South of the River count as originals). Q9.
	measure 'Covers Played' = CALCULATE ( [Performances], KEEPFILTERS ( dim_song[is_original] = FALSE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: f4732823-0b57-4e67-9d79-78f7a68e5bbd

	/// Full performances with a guest artist on stage. Q9.
	measure 'Guest Appearances' = CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[has_guest] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: 01b67987-58e3-468e-9d38-d4facdd8180b

	/// Times the song opened a show (first non-tape song). Q8.
	measure 'Opener Count' = CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[is_opener] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs\Show structure
		lineageTag: 3ba67ad5-95fc-47d3-b0f6-5602d03a54ff

	/// Times the song closed a show (last non-tape song). Q8.
	measure 'Closer Count' = CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[is_closer] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs\Show structure
		lineageTag: 954d194a-765e-492f-8791-2650e9f9560f

	/// Full performances played in an encore. Q8.
	measure 'Encore Count' = CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[is_encore] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs\Show structure
		lineageTag: e6d6ed73-5844-43f9-b201-47a5d77270da

	/// Share of full performances played in an encore. Q8.
	measure 'Encore Share %' = DIVIDE ( [Encore Count], [Performances] )
		formatString: #,0.0%
		displayFolder: Songs\Show structure
		lineageTag: 6d8b1005-064e-4fa9-87b7-f2e3d3044caf

	/// Share of shows with a setlist (in the tour or period in context) where the song was performed in full. Q3.
	measure 'Share of Tour Shows %' = DIVIDE ( [Shows Played], [Shows with Setlist] )
		formatString: #,0.0%
		displayFolder: Tours
		lineageTag: 3648bda2-1659-4261-bf04-bf1aae42284a

	/// Average songs per show of the tour(s) of the shows in context, e.g. to compare one show with its tour. Q8.
	measure 'Tour Avg Songs per Show' =
			VAR ToursOfShows = CALCULATETABLE ( VALUES ( fact_show[tour_key] ) )
			RETURN
			    CALCULATE (
			        [Avg Songs per Show],
			        REMOVEFILTERS ( dim_show ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_venue ),
			        REMOVEFILTERS ( dim_song ), REMOVEFILTERS ( dim_album ), REMOVEFILTERS ( dim_tour ),
			        TREATAS ( ToursOfShows, dim_tour[tour_key] )
			    )
		formatString: #,0.0
		displayFolder: Tours
		lineageTag: 9f2094cc-5e63-4820-b6de-4c1ea9b0fb6b

	/// Share of full performances whose setlist.fm name could not be matched to a song (About page).
	measure 'Unmapped Song Share %' = DIVIDE ( CALCULATE ( [Performances], KEEPFILTERS ( fact_performance[song_key] = -1 ) ), [Performances] )
		formatString: #,0.00%
		displayFolder: Songs\Data quality
		lineageTag: feb39945-1452-44b5-b51b-42a17fc907c9

	/// Title of the one song in context (drill-through header), else blank.
	measure 'Selected Song' = SELECTEDVALUE ( dim_song[song_title] )
		displayFolder: Report\Text
		lineageTag: e0d7745d-5205-4b54-a1fb-4e549a431b6a

	/// Distinct songs in the one era in context minus the previous era; blank when no single era is selected. Q1.
	measure 'Distinct Songs vs Previous Era' =
			VAR CurrentEra = SELECTEDVALUE ( dim_tour[era] )
			VAR PreviousEra = CALCULATE ( MAX ( dim_tour[era] ), REMOVEFILTERS ( dim_tour ), dim_tour[era] < CurrentEra, NOT ISBLANK ( dim_tour[era] ) )
			RETURN IF ( NOT ISBLANK ( CurrentEra ) && NOT ISBLANK ( PreviousEra ), [Distinct Songs] - CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_tour ), dim_tour[era] = PreviousEra ) )
		formatString: +#,0;-#,0;0
		displayFolder: Songs
		lineageTag: 9e6da07a-2b17-4e74-9365-9cc80c6bc4ec

	/// Songs per show at the Sphere residency, whatever tour is selected. Q10.
	measure 'Residency Songs per Show' = CALCULATE ( [Avg Songs per Show], REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () )
		formatString: #,0.0
		displayFolder: Tours\Residency vs touring
		lineageTag: aa6b3551-cf4a-407c-97f7-128f0cc8fb4a

	/// Songs per show on the compared tours: the tours selected (residency excluded), by default the four 2015-2019 tours. Q10.
	measure 'Touring Songs per Show' =
			IF (
			    ISFILTERED ( dim_tour[tour_name_display] ),
			    CALCULATE ( [Avg Songs per Show], KEEPFILTERS ( dim_tour[is_residency] = FALSE () ) ),
			    CALCULATE ( [Avg Songs per Show], REMOVEFILTERS ( dim_tour ), dim_tour[era] = "2015-2019 Innocence and Experience" )
			)
		formatString: #,0.0
		displayFolder: Tours\Residency vs touring
		lineageTag: 7d0c737c-2e0a-4ebc-a3ed-78a3ff0f37f5

	/// Different songs played at the Sphere residency. Q10.
	measure 'Residency Distinct Songs' = CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () )
		formatString: #,0
		displayFolder: Tours\Residency vs touring
		lineageTag: bb941f18-dd7e-4fc6-806c-95226ffc26a8

	/// Different songs played on the compared tours (default: the four 2015-2019 tours). Q10.
	measure 'Touring Distinct Songs' =
			IF (
			    ISFILTERED ( dim_tour[tour_name_display] ),
			    CALCULATE ( [Distinct Songs], KEEPFILTERS ( dim_tour[is_residency] = FALSE () ) ),
			    CALCULATE ( [Distinct Songs], REMOVEFILTERS ( dim_tour ), dim_tour[era] = "2015-2019 Innocence and Experience" )
			)
		formatString: #,0
		displayFolder: Tours\Residency vs touring
		lineageTag: b82d8ff7-f1c4-4609-a074-29a130a223db

	/// Share of full performances from Achtung Baby at the Sphere residency. Q10.
	measure 'Residency Achtung Baby Share %' = CALCULATE ( [Achtung Baby Share %], REMOVEFILTERS ( dim_tour ), dim_tour[is_residency] = TRUE () )
		formatString: #,0.0%
		displayFolder: Tours\Residency vs touring
		lineageTag: 90800b2a-570c-4832-880b-fe523c527dfb

	/// Share of full performances from Achtung Baby on the compared tours (default: the four 2015-2019 tours). Q10.
	measure 'Touring Achtung Baby Share %' =
			IF (
			    ISFILTERED ( dim_tour[tour_name_display] ),
			    CALCULATE ( [Achtung Baby Share %], KEEPFILTERS ( dim_tour[is_residency] = FALSE () ) ),
			    CALCULATE ( [Achtung Baby Share %], REMOVEFILTERS ( dim_tour ), dim_tour[era] = "2015-2019 Innocence and Experience" )
			)
		formatString: #,0.0%
		displayFolder: Tours\Residency vs touring
		lineageTag: 449bf767-e314-4693-8dcd-0bd263a4a092

	/// Residency minus touring songs per show. Q10.
	measure 'Difference Songs per Show' = [Residency Songs per Show] - [Touring Songs per Show]
		formatString: +#,0.0;-#,0.0;0.0
		displayFolder: Tours\Residency vs touring
		lineageTag: a1fc03ba-80e6-4291-b89d-a59482917f01

	/// Residency minus touring distinct songs. Q10.
	measure 'Difference Distinct Songs' = [Residency Distinct Songs] - [Touring Distinct Songs]
		formatString: +#,0;-#,0;0
		displayFolder: Tours\Residency vs touring
		lineageTag: 5b966cd4-4c10-47e1-b2aa-ebbc0af73d57

	/// Residency minus touring Achtung Baby share, in percentage points. Q10.
	measure 'Difference Achtung Baby Share (pp)' = ( [Residency Achtung Baby Share %] - [Touring Achtung Baby Share %] ) * 100
		formatString: +#,0.0;-#,0.0;0.0
		displayFolder: Tours\Residency vs touring
		lineageTag: 178f27c2-851d-4f37-9e69-6f956f7f5d82

	/// Full performances of songs from Achtung Baby (per show on the p06 scatter). Q10.
	measure 'Achtung Baby Performances' = CALCULATE ( [Performances], KEEPFILTERS ( dim_album[album_title] = "Achtung Baby" ), KEEPFILTERS ( dim_album[is_studio] = TRUE () ) )
		formatString: #,0
		displayFolder: Albums
		lineageTag: 664c01e1-bba4-44b8-bf67-42c53090a968

	/// Full performances of songs that have at most two full performances in the whole history (career rarities), e.g. per show. Q2, Q10.
	measure 'Rare Songs Played' = CALCULATE ( [Performances], KEEPFILTERS ( dim_song[full_performances] <= 2 ), KEEPFILTERS ( dim_song[song_key] <> -1 ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: e69a2747-d560-4440-a05b-aee17d97d069

	/// Different songs by other artists performed in full in context (is_original = false). Q9.
	measure 'Cover Songs' = CALCULATE ( [Distinct Songs], KEEPFILTERS ( dim_song[is_original] = FALSE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: 5d02cde4-e3d7-4cf9-a4b3-2223aa505505

	/// Different guest artists (as written on setlist.fm) on full performances in context. Q9.
	measure 'Guest Artists' = CALCULATE ( DISTINCTCOUNT ( fact_performance[guest_artist] ), KEEPFILTERS ( fact_performance[has_guest] = TRUE () ), KEEPFILTERS ( fact_performance[is_snippet] = FALSE () ), KEEPFILTERS ( fact_performance[is_tape] = FALSE () ), KEEPFILTERS ( fact_performance[is_fragment] = FALSE () ) )
		formatString: #,0
		displayFolder: Songs
		lineageTag: e9dc85de-d6a2-4b7b-9b76-b899463c1b67

	/// Different songs that opened at least one show in context. Q8.
	measure 'Opener Songs' = CALCULATE ( [Distinct Songs], KEEPFILTERS ( fact_performance[is_opener] = TRUE () ) )
		formatString: #,0
		displayFolder: Songs\Show structure
		lineageTag: bb40516c-8430-4752-87db-e7e4b0194e80

	/// Foreign key to dim_show.
	column show_key
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 94e1000a-2747-470e-8a57-4a2f1c2977eb
