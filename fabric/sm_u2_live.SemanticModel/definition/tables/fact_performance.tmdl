		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 57b3982e-1c09-474d-823e-eec23fd09d70
		sourceLineageTag: date_key
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	/// Foreign key to dim_song (-1 = unmapped setlist name).
	column song_key
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 1f7861b3-ea2a-466d-a127-d521a61011f7
		sourceLineageTag: song_key
		summarizeBy: none
