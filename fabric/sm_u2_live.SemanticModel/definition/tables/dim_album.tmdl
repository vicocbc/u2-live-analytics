/// MusicBrainz release groups with an official release.
table dim_album
	lineageTag: 6ea6d752-dbe9-424a-9fd2-597387915f73
	sourceLineageTag: [dbo].[dim_album]

	/// Surrogate key (SHA2_256 of the MusicBrainz release group id); -1 = Unknown.
	column album_key
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 78d5accd-0b01-4f54-8bb9-fc73da24c386
		sourceLineageTag: album_key
		summarizeBy: none
		sourceColumn: album_key

		annotation SummarizationSetBy = Automatic

	/// MusicBrainz release group id.
	column album_id
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 6e3c90be-f293-4d9e-b099-9446eb727f48
		sourceLineageTag: album_id
		summarizeBy: none
		sourceColumn: album_id

		annotation SummarizationSetBy = Automatic

	/// Release group title as in MusicBrainz (singles can share a title with an album; use album_type to tell them apart).
	column album_title
		dataType: string
		lineageTag: 69a818f1-b6a1-4ce2-9040-885bd6812f9c
		sourceLineageTag: album_title
		summarizeBy: none
		sourceColumn: album_title

		annotation SummarizationSetBy = Automatic

	/// First release date of the release group.
	column release_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 9c5c38c3-5b49-4266-8e85-fe645423e5ad
		sourceLineageTag: release_date
		summarizeBy: none
		sourceColumn: release_date

		annotation SummarizationSetBy = Automatic

	/// Year of the first release.
	column release_year
		dataType: int64
		formatString: 0
		lineageTag: b7767fce-c0eb-43a6-a2b9-b44f38e877b5
		sourceLineageTag: release_year
		summarizeBy: none
		sourceColumn: release_year

		annotation SummarizationSetBy = Automatic

	/// studio, live, compilation, re-recording, ep or single (SPEC-03 rule plus seeds/album_overrides.csv).
	column album_type
		dataType: string
		lineageTag: f244ebdd-0e5b-4acb-ba3a-b470f6a742b4
		sourceLineageTag: album_type
		summarizeBy: none
		sourceColumn: album_type

		annotation SummarizationSetBy = Automatic

	/// True for the 15 studio albums, Boy (1980) to Carnaval de luz (2026).
	column is_studio
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 39e0f287-2af6-47c4-bdae-6e3bb2451a57
		sourceLineageTag: is_studio
		summarizeBy: none
		sourceColumn: is_studio

		annotation SummarizationSetBy = Automatic

	/// Chronological sort order.
	column album_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ba5ac8c1-15da-4603-b5f6-1b97f67ab392
		sourceLineageTag: album_order
		summarizeBy: none
		sourceColumn: album_order

		annotation SummarizationSetBy = Automatic

	column _built_at
		dataType: dateTime
		isHidden
		formatString: General Date
		isAvailableInMdx: false
		lineageTag: 14b48aa5-d96b-4faa-9630-b0f4b1a8f5df
		sourceLineageTag: _built_at
		summarizeBy: none
		sourceColumn: _built_at

		annotation SummarizationSetBy = Automatic

	/// Unique display name: album title for studio albums, else title with type and year (e.g. One (single, 1992)); sorted chronologically.
	column album_label
		dataType: string
		lineageTag: e3ebe014-b6c3-4634-b21c-dd04a182ce71
		summarizeBy: none
		sourceColumn: album_label
		sortByColumn: album_order

	/// Release decade of the song's studio album (e.g. 1980s albums), else Not on a studio album; legend of the album share area chart. Q5.
	column release_decade_group
		dataType: string
		lineageTag: dba56eea-a780-4547-91cc-a6809485784e
		summarizeBy: none
		sourceColumn: release_decade_group

	partition dim_album = entity
		mode: directLake
		source
			entityName: dim_album
			schemaName: dbo
			expressionSource: 'DirectLake - wh_gold'

