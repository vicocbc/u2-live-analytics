{
  "name": "U2 Live Analytics (dark editorial)",
  "dataColors": [
    "#6FA8DC",
    "#93C47D",
    "#E06666",
    "#B4A7D6",
    "#76D7C4",
    "#F6B26B",
    "#6E7581",
    "#A3A9B3"
  ],
  "foreground": "#ECEDEF",
  "foregroundNeutralSecondary": "#A3A9B3",
  "foregroundNeutralTertiary": "#6E7581",
  "background": "#181B21",
  "backgroundLight": "#20242C",
  "backgroundNeutral": "#2A2F38",
  "tableAccent": "#F2A93B",
  "good": "#93C47D",
  "neutral": "#A3A9B3",
  "bad": "#E06666",
  "maximum": "#6FA8DC",
  "center": "#3B5878",
  "minimum": "#1E2A3A",
  "null": "#181B21",
  "hyperlink": "#6FA8DC",
  "visitedHyperlink": "#B4A7D6",
  "textClasses": {
    "callout": {
      "fontSize": 40,
      "fontFace": "DIN",
      "color": "#ECEDEF"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#ECEDEF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#ECEDEF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A3A9B3"
    },
    "largeTitle": {
      "fontSize": 32,
      "fontFace": "DIN",
      "color": "#ECEDEF"
    },
    "smallLabel": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#A3A9B3"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "show": false,
            "background": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "foreground": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "border": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "transparency": 0
          }
        ],
        "visualTooltip": [
          {
            "type": "Default",
            "background": {
              "solid": {
                "color": "#20242C"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "fontSize": 10
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "show": false,
            "gridlineShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": false,
            "position": "TopLeft",
            "labelColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "transparency": 0
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#181B21"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "transparency": 0,
            "titleSize": 12,
            "headerSize": 10,
            "fontFamily": "Segoe UI",
            "inputBoxColor": {
              "solid": {
                "color": "#20242C"
              }
            },
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#F2A93B"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#20242C"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#181B21"
              }
            },
            "transparency": 0,
            "fontFamily": "Segoe UI",
            "textSize": 10
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#181B21"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#20242C"
              }
            },
            "transparency": 0,
            "fontFamily": "Segoe UI",
            "textSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "transparency": 15
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "fontSize": 44,
            "fontFamily": "DIN"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "fontSize": 44,
            "fontFamily": "DIN"
          }
        ],
        "label": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "transparency": 100
          }
        ],
        "header": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "background": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#20242C"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#2A2F38"
              }
            },
            "rowPadding": 2,
            "outlineColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3A9B3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0F1115"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#20242C"
              }
            }
          }
        ]
      }
    }
  }
}