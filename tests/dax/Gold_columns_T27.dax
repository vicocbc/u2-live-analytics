-- Run through the powerbi-modeling MCP on sm_u2_live. T-SQL: SELECT COUNT(DISTINCT album_label) FROM dbo.dim_album; etc.
-- Expected: 187 distinct album_label = 187 albums; 1875 distinct show_label = 1875 dim_show rows; show_type Residency / Touring (+ blank on Unknown); 6 release_decade_group values
